    def _tree(self, parent: tk.Misc, columns: list[tuple[str, str, int]]) -> ttk.Treeview:
        keys = [column[0] for column in columns]
        tree = ttk.Treeview(parent, columns=keys, show="headings", selectmode="browse")
        for key, title, width in columns:
            tree.heading(key, text=title)
            tree.column(key, width=width, minwidth=55, anchor="w" if key in ("name", "category", "note", "barcode", "date") else "center", stretch=True)
        return tree

    @staticmethod
    def _clear_tree(tree: ttk.Treeview) -> None:
        tree.delete(*tree.get_children())

    def refresh_all(self) -> None:
        summary = self.db.summary()
        self.card_products.value_label.configure(text=str(summary["products"]))
        self.card_sales.value_label.configure(text=money(float(summary["sales_total"])))
        self.card_sales.hint_label.configure(text=f"{summary['sales_count']} işlem")
        self.card_value.value_label.configure(text=money(float(summary["stock_value"])))
        self.card_low.value_label.configure(text=str(summary["low_stock"]))
        self.header_status.configure(text=f"{date.today().strftime('%d.%m.%Y')}  •  {summary['products']} ürün")
        self.refresh_recent()
        self.refresh_product_tree()
        self.refresh_low_stock()
        self.refresh_movements()
        self.refresh_category_values()
        self.refresh_sale_tiles()
        self.refresh_cart()
        self.refresh_report()

    def refresh_recent(self) -> None:
        self._clear_tree(self.recent_tree)
        for row in self.db.recent_sales():
            shown_date = datetime.fromisoformat(row["sold_at"]).strftime("%d.%m.%Y %H:%M")
            self.recent_tree.insert("", "end", values=(f"#{row['id']}", shown_date, row["payment_method"], money(row["total"])))

    def refresh_low_stock(self) -> None:
        self._clear_tree(self.low_tree)
        for row in self.db.low_stock_products():
            self.low_tree.insert("", "end", values=(row["name"], quantity(row["stock"]), quantity(row["min_stock"]), row["unit"]), tags=("low",))

    def refresh_product_tree(self) -> None:
        if self.product_tree is None:
            return
        self._clear_tree(self.product_tree)
        for row in self.db.products(self.product_search.get() if hasattr(self, "product_search") else ""):
            tags = ("low",) if row["stock"] <= row["min_stock"] else ()
            self.product_tree.insert("", "end", iid=str(row["id"]), values=(row["barcode"], row["name"], row["category"], row["unit"],
                                    money(row["price"]), money(row["cost"]), quantity(row["stock"]), quantity(row["min_stock"])), tags=tags)

    def refresh_movements(self) -> None:
        self._clear_tree(self.movement_tree)
        for row in self.db.movements():
            shown_date = datetime.fromisoformat(row["moved_at"]).strftime("%d.%m.%Y %H:%M")
            tag = "in" if row["movement_type"] == "Giriş" else "out"
            self.movement_tree.insert("", "end", values=(shown_date, row["movement_type"], row["barcode"], row["name"],
                                        f"{quantity(row['qty'])} {row['unit']}", row["note"]), tags=(tag,))

    def refresh_category_values(self) -> None:
        if hasattr(self, "category_combo"):
            current = self.category_filter.get() or "Tümü"
            values = ["Tümü", *self.db.categories()]
            self.category_combo.configure(values=values)
            self.category_filter.set(current if current in values else "Tümü")

    def refresh_sale_tiles(self) -> None:
        if not hasattr(self, "tile_frame"):
            return
        for child in self.tile_frame.winfo_children():
            child.destroy()
        rows = self.db.products(self.sale_search.get() if hasattr(self, "sale_search") else "",
                                self.category_filter.get() if hasattr(self, "category_filter") else "Tümü")
        icons = {"Meyve": "🍎", "Sebze": "🥬", "Süt Ürünleri": "🥛", "Fırın": "🥖",
                 "Kahvaltılık": "🫒", "Temel Gıda": "🌾", "Genel": "🛍️"}
        for i, row in enumerate(rows):
            column = i % 4
            line = i // 4
            card = tk.Frame(self.tile_frame, bg="#fbfcfe", highlightthickness=1, highlightbackground="#e2eaf1", cursor="hand2")
            card.grid(row=line, column=column, padx=6, pady=6, sticky="nsew", ipadx=2, ipady=3)
            self.tile_frame.columnconfigure(column, weight=1, uniform="tiles")
            icon = icons.get(row["category"], "🧺")
            title_color = RED if row["stock"] <= row["min_stock"] else TEXT
            tk.Label(card, text=icon, bg="#fbfcfe", fg=GREEN, font=("Segoe UI Emoji", 24)).pack(pady=(7, 2))
            tk.Label(card, text=row["name"], bg="#fbfcfe", fg=TEXT, font=("Segoe UI", 9, "bold"),
                     wraplength=135, height=2).pack(fill="x", padx=5)
            tk.Label(card, text=money(row["price"]), bg="#fbfcfe", fg=GREEN, font=("Segoe UI", 10, "bold")).pack(pady=(2, 0))
            tk.Label(card, text=f"Stok {quantity(row['stock'])} {row['unit']}", bg="#fbfcfe", fg=title_color,
                     font=("Segoe UI", 8)).pack(pady=(0, 7))
            for widget in card.winfo_children() + [card]:
                widget.bind("<Button-1>", lambda _event, product_id=row["id"]: self.add_to_cart(product_id))

    def add_to_cart(self, product_id: int) -> None:
        product = self.db.product(product_id)
        if product is None:
            return
        desired = self.cart.get(product_id, 0) + 1
        if desired > product["stock"]:
            messagebox.showwarning("Stok yetersiz", f"{product['name']} için yeterli stok yok.", parent=self.root)
            return
        self.cart[product_id] = desired
        self.refresh_cart()

    def scan_or_add_product(self, _event: tk.Event | None = None) -> str:
        term = self.sale_search.get().strip()
        if not term:
            return "break"
        matches = self.db.products(term)
        exact = next((row for row in matches if row["barcode"] == term), None)
        product = exact or (matches[0] if len(matches) == 1 else None)
        if product is None:
            messagebox.showinfo("Ürün bulunamadı", "Barkod veya ürün adını kontrol edin.", parent=self.root)
            return "break"
        self.add_to_cart(product["id"])
        self.sale_search.set("")
        return "break"

    def _selected_cart_id(self) -> int | None:
        selection = self.cart_tree.selection() if self.cart_tree else ()
        return int(selection[0]) if selection else None

    def adjust_cart(self, delta: int) -> None:
        product_id = self._selected_cart_id()
        if product_id is None:
            messagebox.showinfo("Sepet", "Önce sepette bir ürün seçin.", parent=self.root)
            return
        product = self.db.product(product_id)
        new_qty = self.cart[product_id] + delta
        if new_qty <= 0:
            self.cart.pop(product_id, None)
        elif product and new_qty <= product["stock"]:
            self.cart[product_id] = new_qty
        else:
            messagebox.showwarning("Stok yetersiz", "Sepet miktarı mevcut stoğu aşamaz.", parent=self.root)
        self.refresh_cart()

    def set_cart_qty(self) -> None:
        product_id = self._selected_cart_id()
        if product_id is None:
            messagebox.showinfo("Sepet", "Önce sepette bir ürün seçin.", parent=self.root)
            return
        product = self.db.product(product_id)
        value = simpledialog.askstring("Miktar", f"Miktar ({product['unit']})", initialvalue=quantity(self.cart[product_id]), parent=self.root)
        if value is None:
            return
        try:
            new_qty = parse_number(value, "Miktar", allow_zero=False)
        except ValueError as exc:
            messagebox.showerror("Geçersiz miktar", str(exc), parent=self.root)
            return
        if new_qty > product["stock"]:
            messagebox.showwarning("Stok yetersiz", "Sepet miktarı mevcut stoğu aşamaz.", parent=self.root)
            return
        self.cart[product_id] = new_qty
        self.refresh_cart()

    def remove_cart_item(self) -> None:
        product_id = self._selected_cart_id()
        if product_id is None:
            return
        self.cart.pop(product_id, None)
        self.refresh_cart()

    def refresh_cart(self) -> None:
        if self.cart_tree is None:
            return
        self._clear_tree(self.cart_tree)
        total = 0.0
        for product_id, qty in self.cart.items():
            product = self.db.product(product_id)
            if not product:
                continue
            line = round(product["price"] * qty, 2)
            total += line
            self.cart_tree.insert("", "end", iid=str(product_id), values=(product["barcode"], product["name"],
                                 quantity(qty), money(product["price"]), money(line)))
        self.cart_total_label.configure(text=money(total))
        if hasattr(self, "sale_status"):
            self.sale_status.configure(text=f"Sepette {len(self.cart)} ürün çeşidi")

    def checkout(self, payment: str) -> None:
        try:
            sale_id, total = self.db.complete_sale(self.cart, payment)
        except (ValueError, sqlite3.Error) as exc:
            messagebox.showerror("Satış tamamlanamadı", str(exc), parent=self.root)
            return
        self.cart.clear()
        self.refresh_all()
        messagebox.showinfo("Satış tamamlandı", f"Fiş #{sale_id}\nÖdeme: {payment}\nToplam: {money(total)}", parent=self.root)

    def _selected_product(self) -> sqlite3.Row | None:
        selection = self.product_tree.selection() if self.product_tree else ()
        if not selection:
            messagebox.showinfo("Ürün seçin", "İşlem yapmak için ürün tablosundan bir ürün seçin.", parent=self.root)
            return None
        return self.db.product(int(selection[0]))

    def add_product(self) -> None:
        dialog = ProductDialog(self.root, self.db)
        if dialog.result:
            self.refresh_all()

    def edit_product(self) -> None:
        product = self._selected_product()
        if product is None:
            return
        dialog = ProductDialog(self.root, self.db, product)
        if dialog.result:
            self.refresh_all()

    def delete_product(self) -> None:
        product = self._selected_product()
        if product is None:
            return
        if not messagebox.askyesno("Ürünü sil", f"{product['name']} ürününü silmek istiyor musunuz?", parent=self.root):
            return
        try:
            self.db.delete_product(product["id"])
        except sqlite3.IntegrityError:
            messagebox.showerror("Ürün silinemedi", "Satış veya stok hareketi bulunan ürün, geçmiş kayıtların bütünlüğü için silinemez.", parent=self.root)
            return
        self.refresh_all()

    def move_stock(self) -> None:
        product = self._selected_product()
        if product is None:
            return
        dialog = StockDialog(self.root, self.db, product)
        if dialog.result:
            self.refresh_all()

    def refresh_report(self) -> None:
        if self.report_sales_tree is None:
            return
        start = self.report_start.get().strip()
        end = self.report_end.get().strip()
        try:
            parsed_start = date.fromisoformat(start)
            parsed_end = date.fromisoformat(end)
        except ValueError:
            messagebox.showerror("Tarih aralığı geçersiz", "Tarihleri YYYY-AA-GG biçiminde girin.", parent=self.root)
            return
        if parsed_start > parsed_end:
            messagebox.showerror("Tarih aralığı geçersiz", "Başlangıç tarihi bitiş tarihinden sonra olamaz.", parent=self.root)
            return
        sales, top_items, total = self.db.report(start, end)
        self._clear_tree(self.report_sales_tree)
        for row in sales:
            shown_date = datetime.fromisoformat(row["sold_at"]).strftime("%d.%m.%Y %H:%M")
            self.report_sales_tree.insert("", "end", values=(f"#{row['id']}", shown_date, row["payment_method"], money(row["total"])))
        self._clear_tree(self.report_items_tree)
        for row in top_items:
            self.report_items_tree.insert("", "end", values=(row["product_name"], quantity(row["qty"]), money(row["total"])))
        self.report_total.configure(text=f"Dönem satış toplamı: {money(total)}  •  {len(sales)} satış")

    def export_report(self) -> None:
        self.refresh_report()
        start, end = self.report_start.get().strip(), self.report_end.get().strip()
        try:
            parsed_start = date.fromisoformat(start)
            parsed_end = date.fromisoformat(end)
        except ValueError:
            messagebox.showerror("Tarih aralığı geçersiz", "Tarihleri YYYY-AA-GG biçiminde girin.", parent=self.root)
            return
        if parsed_start > parsed_end:
            messagebox.showerror("Tarih aralığı geçersiz", "Başlangıç tarihi bitiş tarihinden sonra olamaz.", parent=self.root)
            return
        path = filedialog.asksaveasfilename(parent=self.root, title="Satış raporunu kaydet",
                    defaultextension=".csv", initialfile=f"satis_raporu_{start}_{end}.csv",
                    filetypes=[("CSV dosyası", "*.csv")])
        if not path:
            return
        sales, top_items, total = self.db.report(start, end)
        with open(path, "w", newline="", encoding="utf-8-sig") as file:
            writer = csv.writer(file, delimiter=";")
            writer.writerow(["SATIŞLAR"])
            writer.writerow(["Fiş", "Tarih", "Ödeme", "Toplam (TL)"])
            for row in sales:
                writer.writerow([row["id"], row["sold_at"], row["payment_method"], row["total"]])
            writer.writerow([])
            writer.writerow(["Dönem toplamı (TL)", total])
            writer.writerow([])
            writer.writerow(["EN ÇOK CİRO YAPAN ÜRÜNLER"])
            writer.writerow(["Ürün", "Satılan miktar", "Ciro (TL)"])
            for row in top_items:
                writer.writerow([row["product_name"], row["qty"], row["total"]])
        messagebox.showinfo("Rapor kaydedildi", f"CSV raporu kaydedildi:\n{path}", parent=self.root)

    def close(self) -> None:
        self.db.close()
        self.root.destroy()


def main() -> None:
    root = tk.Tk()
    InventoryApp(root)
    root.mainloop()


if __name__ == "__main__":
    main()
