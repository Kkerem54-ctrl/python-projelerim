        self.configure(bg=WHITE)
        self.resizable(False, False)
        self.transient(parent)
        self.grab_set()
        body = ttk.Frame(self, padding=22)
        body.grid(sticky="nsew")
        ttk.Label(body, text=product["name"], style="DialogTitle.TLabel").grid(row=0, column=0, columnspan=2, sticky="w", pady=(0, 5))
        ttk.Label(body, text=f"Mevcut stok: {quantity(product['stock'])} {product['unit']}", style="Muted.TLabel").grid(row=1, column=0, columnspan=2, sticky="w", pady=(0, 14))
        ttk.Label(body, text="Hareket türü").grid(row=2, column=0, sticky="w", pady=5)
        self.kind = tk.StringVar(value="Giriş")
        ttk.Combobox(body, textvariable=self.kind, values=["Giriş", "Çıkış"], state="readonly", width=25).grid(row=2, column=1, pady=5)
        ttk.Label(body, text="Miktar").grid(row=3, column=0, sticky="w", pady=5)
        self.qty = tk.StringVar(value="1")
        ttk.Entry(body, textvariable=self.qty, width=28).grid(row=3, column=1, pady=5)
        ttk.Label(body, text="Açıklama").grid(row=4, column=0, sticky="w", pady=5)
        self.note = tk.StringVar()
        ttk.Entry(body, textvariable=self.note, width=28).grid(row=4, column=1, pady=5)
        buttons = ttk.Frame(body)
        buttons.grid(row=5, column=0, columnspan=2, sticky="e", pady=(14, 0))
        ttk.Button(buttons, text="Vazgeç", command=self.destroy).pack(side="right", padx=(8, 0))
        ttk.Button(buttons, text="Uygula", style="Accent.TButton", command=self._apply).pack(side="right")

    def _apply(self) -> None:
        try:
            qty = parse_number(self.qty.get(), "Miktar", allow_zero=False)
            self.db.change_stock(self.product["id"], self.kind.get(), qty, self.note.get().strip())
        except (ValueError, sqlite3.Error) as exc:
            messagebox.showerror("Stok güncellenemedi", str(exc), parent=self)
            return
        self.result = True
        self.destroy()


class InventoryApp:
    def __init__(self, root: tk.Tk):
        self.root = root
        self.db = Database(DB_PATH)
        self.cart: dict[int, float] = {}
        self.cart_tree: ttk.Treeview | None = None
        self.product_tree: ttk.Treeview | None = None
        self.movement_tree: ttk.Treeview | None = None
        self.report_sales_tree: ttk.Treeview | None = None
        self.report_items_tree: ttk.Treeview | None = None
        self.root.title("MaviKasa | Stok ve Ürün Yönetimi")
        self.root.geometry("1380x860")
        self.root.minsize(1120, 720)
        self.root.configure(bg=BG)
        self._style()
        self._build_shell()
        self.refresh_all()
        self.root.protocol("WM_DELETE_WINDOW", self.close)

    def _style(self) -> None:
        style = ttk.Style()
        style.theme_use("clam")
        style.configure("TFrame", background=BG)
        style.configure("White.TFrame", background=WHITE)
        style.configure("TLabel", background=BG, foreground=TEXT, font=("Segoe UI", 10))
        style.configure("Muted.TLabel", background=BG, foreground=MUTED, font=("Segoe UI", 9))
        style.configure("DialogTitle.TLabel", background=WHITE, foreground=NAVY, font=("Segoe UI", 15, "bold"))
        style.configure("TButton", font=("Segoe UI", 10), padding=(11, 8))
        style.configure("Accent.TButton", background=GREEN, foreground=WHITE, borderwidth=0, font=("Segoe UI", 10, "bold"))
        style.map("Accent.TButton", background=[("active", "#0d8f70")])
        style.configure("Danger.TButton", background="#fff0f1", foreground=RED, borderwidth=0)
        style.configure("Treeview", background=WHITE, fieldbackground=WHITE, foreground=TEXT,
                        rowheight=32, font=("Segoe UI", 9), borderwidth=0)
        style.configure("Treeview.Heading", background="#edf2f7", foreground="#536477",
                        font=("Segoe UI", 9, "bold"), relief="flat", padding=7)
        style.map("Treeview", background=[("selected", "#d9f3ec")], foreground=[("selected", NAVY)])
        style.configure("TNotebook", background=BG, borderwidth=0)
        style.configure("TNotebook.Tab", background="#e7edf4", foreground="#526378",
                        padding=(18, 11), font=("Segoe UI", 10, "bold"))
        style.map("TNotebook.Tab", background=[("selected", WHITE)], foreground=[("selected", GREEN)])
        style.configure("TEntry", padding=7)
        style.configure("TCombobox", padding=6)

    def _build_shell(self) -> None:
        header = tk.Frame(self.root, bg=NAVY, height=82)
        header.pack(fill="x")
        header.pack_propagate(False)
        brand = tk.Frame(header, bg=NAVY)
        brand.pack(side="left", padx=25, pady=13)
        tk.Label(brand, text="MAVİKASA", bg=NAVY, fg=WHITE, font=("Segoe UI", 18, "bold")).pack(anchor="w")
        tk.Label(brand, text="Stok ve satış yönetimi", bg=NAVY, fg="#b8c6d8", font=("Segoe UI", 9)).pack(anchor="w")
        self.header_status = tk.Label(header, text="", bg=NAVY, fg="#c8d5e4", font=("Segoe UI", 10))
        self.header_status.pack(side="right", padx=25)
        outer = ttk.Frame(self.root, padding=(18, 14, 18, 14))
        outer.pack(fill="both", expand=True)
        self.tabs = ttk.Notebook(outer)
        self.tabs.pack(fill="both", expand=True)
        self.dashboard_tab = ttk.Frame(self.tabs, padding=16)
        self.sale_tab = ttk.Frame(self.tabs, padding=14)
        self.products_tab = ttk.Frame(self.tabs, padding=16)
        self.movements_tab = ttk.Frame(self.tabs, padding=16)
        self.reports_tab = ttk.Frame(self.tabs, padding=16)
        self.tabs.add(self.dashboard_tab, text="  Genel Bakış  ")
        self.tabs.add(self.sale_tab, text="  Hızlı Satış  ")
        self.tabs.add(self.products_tab, text="  Ürünler  ")
        self.tabs.add(self.movements_tab, text="  Stok Hareketleri  ")
        self.tabs.add(self.reports_tab, text="  Raporlar  ")
        self._build_dashboard()
        self._build_sale()
        self._build_products()
        self._build_movements()
        self._build_reports()
        self.tabs.select(self.sale_tab)
        footer = tk.Label(self.root, text="SQLite ile güvenli yerel kayıt  •  Kritik stoklar anlık izlenir",
                          bg=BG, fg="#8794a5", font=("Segoe UI", 8))
        footer.pack(side="bottom", pady=(0, 8))

    def _card(self, parent: tk.Misc, title: str, value: str, hint: str, color: str) -> tk.Frame:
        frame = tk.Frame(parent, bg=WHITE, highlightthickness=1, highlightbackground="#e7edf3")
        tk.Frame(frame, bg=color, width=5).pack(side="left", fill="y")
        content = tk.Frame(frame, bg=WHITE, padx=15, pady=12)
        content.pack(side="left", fill="both", expand=True)
        tk.Label(content, text=title.upper(), bg=WHITE, fg=MUTED, font=("Segoe UI", 8, "bold")).pack(anchor="w")
        value_label = tk.Label(content, text=value, bg=WHITE, fg=NAVY, font=("Segoe UI", 20, "bold"))
        value_label.pack(anchor="w", pady=(5, 1))
        hint_label = tk.Label(content, text=hint, bg=WHITE, fg=MUTED, font=("Segoe UI", 8))
        hint_label.pack(anchor="w")
        frame.value_label = value_label
