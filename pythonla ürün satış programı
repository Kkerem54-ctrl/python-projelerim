def money(value: float) -> str:
    return f"₺{value:,.2f}".replace(",", "X").replace(".", ",").replace("X", ".")


def quantity(value: float) -> str:
    return f"{value:g}".replace(".", ",")


def parse_number(value: str, label: str, *, allow_zero: bool = True) -> float:
    normalized = value.strip().replace("₺", "").replace(" ", "")
    if "," in normalized and "." in normalized:
        normalized = normalized.replace(".", "").replace(",", ".")
    else:
        normalized = normalized.replace(",", ".")
    try:
        number = float(normalized)
    except ValueError as exc:
        raise ValueError(f"{label} geçerli bir sayı olmalıdır.") from exc
    if not math.isfinite(number):
        raise ValueError(f"{label} geçerli bir sayı olmalıdır.")
    if number < 0 or (not allow_zero and number == 0):
        condition = "0'dan büyük" if not allow_zero else "0 veya daha büyük"
        raise ValueError(f"{label} {condition} olmalıdır.")
    return number


class Database:
    """SQLite veri erişim katmanı ve stok/satış işlemleri."""

    def __init__(self, path: Path):
        self.connection = sqlite3.connect(path)
        self.connection.row_factory = sqlite3.Row
        self.connection.execute("PRAGMA foreign_keys = ON")
        self._create_schema()
        self._seed_if_empty()

    def _create_schema(self) -> None:
        self.connection.executescript(
            """
            CREATE TABLE IF NOT EXISTS products (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                barcode TEXT NOT NULL UNIQUE,
                name TEXT NOT NULL,
                category TEXT NOT NULL DEFAULT 'Genel',
                unit TEXT NOT NULL DEFAULT 'Adet',
                price REAL NOT NULL CHECK(price >= 0),
                cost REAL NOT NULL DEFAULT 0 CHECK(cost >= 0),
                stock REAL NOT NULL DEFAULT 0 CHECK(stock >= 0),
                min_stock REAL NOT NULL DEFAULT 0 CHECK(min_stock >= 0),
                created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
            );
            CREATE TABLE IF NOT EXISTS sales (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                sold_at TEXT NOT NULL,
                total REAL NOT NULL,
                payment_method TEXT NOT NULL
            );
            CREATE TABLE IF NOT EXISTS sale_items (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                sale_id INTEGER NOT NULL REFERENCES sales(id),
                product_id INTEGER NOT NULL REFERENCES products(id) ON DELETE RESTRICT,
                product_name TEXT NOT NULL,
                barcode TEXT NOT NULL,
                qty REAL NOT NULL CHECK(qty > 0),
                unit_price REAL NOT NULL,
                line_total REAL NOT NULL
            );
            CREATE TABLE IF NOT EXISTS stock_movements (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                product_id INTEGER NOT NULL REFERENCES products(id) ON DELETE RESTRICT,
                moved_at TEXT NOT NULL,
                movement_type TEXT NOT NULL,
                qty REAL NOT NULL CHECK(qty > 0),
                note TEXT NOT NULL DEFAULT ''
            );
            CREATE INDEX IF NOT EXISTS idx_sales_sold_at ON sales(sold_at);
            CREATE INDEX IF NOT EXISTS idx_movements_moved_at ON stock_movements(moved_at);
            CREATE TABLE IF NOT EXISTS app_meta (
                key TEXT PRIMARY KEY,
                value TEXT NOT NULL
            );
            """
        )
        self.connection.commit()

    def _seed_if_empty(self) -> None:
        already_seeded = self.connection.execute(
            "SELECT 1 FROM app_meta WHERE key='sample_data_seeded'"
        ).fetchone()
        if already_seeded:
            return
        examples = [
            ("8690000000011", "Domates", "Sebze", "Kg", 34.90, 22.00, 28, 5),
            ("8690000000012", "Salatalık", "Sebze", "Kg", 29.90, 18.00, 20, 4),
            ("8690000000013", "Elma", "Meyve", "Kg", 42.50, 28.00, 16, 4),
            ("8690000000014", "Limon", "Meyve", "Kg", 39.90, 25.00, 12, 3),
            ("8690000000015", "Patates", "Sebze", "Kg", 19.90, 12.00, 35, 6),
            ("8690000000016", "Süt 1 L", "Süt Ürünleri", "Adet", 32.00, 23.00, 18, 5),
            ("8690000000017", "Yumurta 10'lu", "Süt Ürünleri", "Paket", 74.90, 56.00, 10, 3),
            ("8690000000018", "Somun Ekmek", "Fırın", "Adet", 12.50, 8.00, 24, 5),
            ("8690000000019", "Mandalina", "Meyve", "Kg", 36.90, 24.00, 3, 4),
            ("8690000000020", "Zeytin 500 g", "Kahvaltılık", "Paket", 89.00, 66.00, 8, 2),
            ("8690000000021", "Pirinç 1 kg", "Temel Gıda", "Paket", 54.90, 42.00, 15, 4),
            ("8690000000022", "Soğan", "Sebze", "Kg", 17.90, 10.00, 2, 4),
        ]
        self.connection.executemany(
            """INSERT INTO products(barcode,name,category,unit,price,cost,stock,min_stock)
               VALUES(?,?,?,?,?,?,?,?)""",
            examples,
        )
        self.connection.execute("INSERT INTO app_meta(key,value) VALUES('sample_data_seeded','1')")
        self.connection.commit()

    def products(self, search: str = "", category: str = "Tümü") -> list[sqlite3.Row]:
        query = "SELECT * FROM products WHERE (name LIKE ? OR barcode LIKE ?)"
        args: list[object] = [f"%{search}%", f"%{search}%"]
        if category and category != "Tümü":
            query += " AND category=?"
            args.append(category)
        return list(self.connection.execute(query + " ORDER BY name COLLATE NOCASE", args))

    def categories(self) -> list[str]:
        return [row[0] for row in self.connection.execute(
            "SELECT DISTINCT category FROM products ORDER BY category COLLATE NOCASE"
        )]

    def product(self, product_id: int) -> sqlite3.Row | None:
        return self.connection.execute("SELECT * FROM products WHERE id=?", (product_id,)).fetchone()

    def save_product(self, values: dict[str, object], product_id: int | None = None) -> None:
        cursor = self.connection.cursor()
        cursor.execute("BEGIN IMMEDIATE")
        try:
            if product_id is None:
                cursor.execute(
                    """INSERT INTO products(barcode,name,category,unit,price,cost,stock,min_stock)
                       VALUES(:barcode,:name,:category,:unit,:price,:cost,:stock,:min_stock)""", values
                )
                new_id = cursor.lastrowid
                if float(values["stock"]) > 0:
                    cursor.execute(
                        """INSERT INTO stock_movements(product_id,moved_at,movement_type,qty,note)
                           VALUES(?,?,?,?,?)""",
                        (new_id, datetime.now().isoformat(timespec="seconds"), "Giriş",
                         float(values["stock"]), "Açılış stoğu"),
                    )
            else:
                cursor.execute(
                    """UPDATE products SET barcode=:barcode,name=:name,category=:category,unit=:unit,
                       price=:price,cost=:cost,min_stock=:min_stock WHERE id=:id""",
                    {**values, "id": product_id},
                )
            self.connection.commit()
        except Exception:
            self.connection.rollback()
            raise

    def delete_product(self, product_id: int) -> None:
        self.connection.execute("DELETE FROM products WHERE id=?", (product_id,))
        self.connection.commit()

    def change_stock(self, product_id: int, movement_type: str, qty: float, note: str) -> None:
        if qty <= 0:
            raise ValueError("Stok miktarı 0'dan büyük olmalıdır.")
        cursor = self.connection.cursor()
        cursor.execute("BEGIN IMMEDIATE")
        try:
            row = cursor.execute("SELECT stock FROM products WHERE id=?", (product_id,)).fetchone()
            if not row:
                raise ValueError("Ürün bulunamadı.")
            new_stock = row[0] + qty if movement_type == "Giriş" else row[0] - qty
            if new_stock < 0:
                raise ValueError("Stok miktarı mevcut stoktan fazla olamaz.")
            cursor.execute("UPDATE products SET stock=? WHERE id=?", (new_stock, product_id))
            cursor.execute(
                "INSERT INTO stock_movements(product_id,moved_at,movement_type,qty,note) VALUES(?,?,?,?,?)",
                (product_id, datetime.now().isoformat(timespec="seconds"), movement_type, qty, note),
            )
            self.connection.commit()
        except Exception:
            self.connection.rollback()
            raise

    def complete_sale(self, cart: dict[int, float], payment_method: str) -> tuple[int, float]:
        if not cart:
            raise ValueError("Sepet boş. Önce satışa ürün ekleyin.")
        cursor = self.connection.cursor()
        cursor.execute("BEGIN IMMEDIATE")
        try:
            items: list[tuple[sqlite3.Row, float, float]] = []
            total = 0.0
            for product_id, qty in cart.items():
                if qty <= 0:
                    raise ValueError("Ürün miktarı 0'dan büyük olmalıdır.")
                product = cursor.execute("SELECT * FROM products WHERE id=?", (product_id,)).fetchone()
                if product is None:
                    raise ValueError("Sepetteki ürün artık bulunamıyor.")
                if product["stock"] < qty:
                    raise ValueError(f"{product['name']} için stok yetersiz. Mevcut: {quantity(product['stock'])} {product['unit']}.")
                line_total = round(product["price"] * qty, 2)
                items.append((product, qty, line_total))
                total += line_total
            sold_at = datetime.now().isoformat(timespec="seconds")
            cursor.execute("INSERT INTO sales(sold_at,total,payment_method) VALUES(?,?,?)",
                           (sold_at, round(total, 2), payment_method))
            sale_id = cursor.lastrowid
            for product, qty, line_total in items:
                cursor.execute(
                    """INSERT INTO sale_items(sale_id,product_id,product_name,barcode,qty,unit_price,line_total)
                       VALUES(?,?,?,?,?,?,?)""",
                    (sale_id, product["id"], product["name"], product["barcode"], qty,
                     product["price"], line_total),
                )
                cursor.execute("UPDATE products SET stock=stock-? WHERE id=?", (qty, product["id"]))
                cursor.execute(
                    """INSERT INTO stock_movements(product_id,moved_at,movement_type,qty,note)
                       VALUES(?,?,?,?,?)""",
                    (product["id"], sold_at, "Satış", qty, f"Satış #{sale_id}"),
                )
            self.connection.commit()
            return int(sale_id), round(total, 2)
        except Exception:
            self.connection.rollback()
            raise

    def summary(self) -> dict[str, float | int]:
        products = self.connection.execute(
            "SELECT COUNT(*) AS count, COALESCE(SUM(stock*cost),0) AS value FROM products"
        ).fetchone()
        sales = self.connection.execute(
            "SELECT COUNT(*) AS count, COALESCE(SUM(total),0) AS total FROM sales WHERE date(sold_at)=date('now','localtime')"
        ).fetchone()
        low = self.connection.execute("SELECT COUNT(*) FROM products WHERE stock<=min_stock").fetchone()[0]
        return {"products": products["count"], "stock_value": products["value"],
                "sales_count": sales["count"], "sales_total": sales["total"], "low_stock": low}

    def recent_sales(self, limit: int = 8) -> list[sqlite3.Row]:
        return list(self.connection.execute("SELECT * FROM sales ORDER BY id DESC LIMIT ?", (limit,)))

    def low_stock_products(self) -> list[sqlite3.Row]:
        return list(self.connection.execute(
            "SELECT * FROM products WHERE stock<=min_stock ORDER BY stock ASC,name COLLATE NOCASE"
        ))

    def movements(self, limit: int = 500) -> list[sqlite3.Row]:
        return list(self.connection.execute(
            """SELECT m.*,p.name,p.barcode,p.unit FROM stock_movements m
               JOIN products p ON p.id=m.product_id ORDER BY m.id DESC LIMIT ?""", (limit,)
        ))

    def report(self, start: str, end: str) -> tuple[list[sqlite3.Row], list[sqlite3.Row], float]:
        sales = list(self.connection.execute(
            "SELECT * FROM sales WHERE date(sold_at) BETWEEN date(?) AND date(?) ORDER BY sold_at DESC",
            (start, end),
        ))
        top_products = list(self.connection.execute(
            """SELECT product_name,SUM(qty) AS qty,SUM(line_total) AS total
               FROM sale_items JOIN sales ON sales.id=sale_items.sale_id
               WHERE date(sales.sold_at) BETWEEN date(?) AND date(?)
               GROUP BY product_name ORDER BY total DESC LIMIT 10""", (start, end)
        ))
        return sales, top_products, round(sum(row["total"] for row in sales), 2)

    def close(self) -> None:
        self.connection.close()


class ProductDialog(tk.Toplevel):
    def __init__(self, parent: tk.Misc, db: Database, product: sqlite3.Row | None = None):
        super().__init__(parent)
        self.db = db
        self.product = product
        self.result = False
        self.title("Ürünü Düzenle" if product else "Yeni Ürün")
        self.configure(bg=WHITE)
        self.resizable(False, False)
        self.transient(parent)
        self.grab_set()
        self.vars = {key: tk.StringVar(value="") for key in
                     ("barcode", "name", "category", "unit", "price", "cost", "stock", "min_stock")}
        if product:
            for key in self.vars:
                self.vars[key].set(str(product[key]))
        else:
            self.vars["category"].set("Genel")
            self.vars["unit"].set("Adet")
            self.vars["stock"].set("0")
            self.vars["min_stock"].set("0")
        self._build()
        self.wait_visibility()
        self.focus_force()

    def _build(self) -> None:
        body = ttk.Frame(self, padding=22)
        body.grid(sticky="nsew")
        ttk.Label(body, text="Ürün bilgileri", style="DialogTitle.TLabel").grid(row=0, column=0, columnspan=2, sticky="w", pady=(0, 16))
        fields = [("Barkod *", "barcode", None), ("Ürün adı *", "name", None),
                  ("Kategori", "category", None), ("Birim", "unit", ["Adet", "Kg", "Litre", "Paket", "Kutu"]),
                  ("Satış fiyatı (₺) *", "price", None), ("Alış maliyeti (₺)", "cost", None),
                  ("Mevcut stok (stok hareketiyle değişir)", "stock", None), ("Kritik stok seviyesi", "min_stock", None)]
        for i, (label, key, choices) in enumerate(fields, start=1):
            ttk.Label(body, text=label).grid(row=i, column=0, sticky="w", pady=5, padx=(0, 14))
            if choices:
                widget = ttk.Combobox(body, textvariable=self.vars[key], values=choices, state="readonly", width=28)
            else:
                widget = ttk.Entry(body, textvariable=self.vars[key], width=31)
                if key == "stock" and self.product is not None:
                    widget.configure(state="disabled")
            widget.grid(row=i, column=1, sticky="ew", pady=5)
        buttons = ttk.Frame(body)
        buttons.grid(row=9, column=0, columnspan=2, sticky="e", pady=(16, 0))
        ttk.Button(buttons, text="Vazgeç", command=self.destroy).pack(side="right", padx=(8, 0))
        ttk.Button(buttons, text="Kaydet", style="Accent.TButton", command=self._save).pack(side="right")

    def _save(self) -> None:
        values = {key: variable.get().strip() for key, variable in self.vars.items()}
        if not values["barcode"] or not values["name"]:
            messagebox.showerror("Eksik bilgi", "Barkod ve ürün adı zorunludur.", parent=self)
            return
        try:
            values["price"] = parse_number(str(values["price"]), "Satış fiyatı")
            values["cost"] = parse_number(str(values["cost"] or "0"), "Alış maliyeti")
            values["stock"] = parse_number(str(values["stock"] or "0"), "Stok")
            values["min_stock"] = parse_number(str(values["min_stock"] or "0"), "Kritik stok seviyesi")
            values["category"] = values["category"] or "Genel"
            values["unit"] = values["unit"] or "Adet"
            self.db.save_product(values, self.product["id"] if self.product else None)
        except (ValueError, sqlite3.IntegrityError) as exc:
            message = "Bu barkod başka bir üründe kullanılıyor." if isinstance(exc, sqlite3.IntegrityError) else str(exc)
            messagebox.showerror("Ürün kaydedilemedi", message, parent=self)
            return
        self.result = True
        self.destroy()


