def distance_to_segment(px, py, ax, ay, bx, by):
    dx = bx - ax
    dy = by - ay
    length_sq = dx * dx + dy * dy
    if length_sq == 0:
        return math.hypot(px - ax, py - ay)
    t = max(0.0, min(1.0, ((px - ax) * dx + (py - ay) * dy) / length_sq))
    closest_x = ax + t * dx
    closest_y = ay + t * dy
    return math.hypot(px - closest_x, py - closest_y)


class Enemy:
    def __init__(self, kind, wave, path_lengths, total_path_length):
        info = ENEMY_TYPES[kind]
        scale = 1.0 + (wave - 1) * 0.16
        self.kind = kind
        self.name = info["name"]
        self.max_health = int(info["hp"] * scale)
        self.health = self.max_health
        self.speed = info["speed"] * (1.0 + min(wave - 1, 12) * 0.018)
        self.reward = int(info["reward"] * (1.0 + (wave - 1) * 0.06))
        self.armor = info["armor"] + (1 if kind == "armored" and wave >= 7 else 0)
        self.color = info["color"]
        self.base_damage = info["base_damage"]
        self.path_lengths = path_lengths
        self.total_path_length = total_path_length
        self.travelled = 0.0
        self.x, self.y = PATH_POINTS[0]
        self.alive = True
        self.slow_until = 0.0
        self.slow_factor = 1.0

    def update(self, dt, now):
        if not self.alive:
            return False
        speed_factor = self.slow_factor if now < self.slow_until else 1.0
        if now >= self.slow_until:
            self.slow_factor = 1.0
        self.travelled += self.speed * speed_factor * dt
        if self.travelled >= self.total_path_length:
            self.x, self.y = PATH_POINTS[-1]
            return True
        remaining = self.travelled
        for index, segment_length in enumerate(self.path_lengths):
            if remaining <= segment_length:
                ax, ay = PATH_POINTS[index]
                bx, by = PATH_POINTS[index + 1]
                ratio = remaining / segment_length if segment_length else 0.0
                self.x = ax + (bx - ax) * ratio
                self.y = ay + (by - ay) * ratio
                break
            remaining -= segment_length
        return False


class Tower:
    def __init__(self, kind, x, y):
        self.kind = kind
        self.x = x
        self.y = y
        self.level = 1
        self.cooldown = random.random() * 0.25
        self.info = TOWER_TYPES[kind]

    @property
    def attack_range(self):
        return self.info["range"] + (self.level - 1) * 12

    @property
    def damage(self):
        return self.info["damage"] * (1.0 + (self.level - 1) * 0.38)

    @property
    def attack_rate(self):
        return self.info["rate"] * (0.91 ** (self.level - 1))

    def upgrade_cost(self):
        return int(self.info["cost"] * 0.65 + self.level * 32)

    def sell_value(self):
        invested = self.info["cost"]
        for level in range(1, self.level):
            invested += int(self.info["cost"] * 0.65 + level * 32)
        return int(invested * 0.68)


class Projectile:
    def __init__(self, x, y, target, damage, kind):
        self.x = x
        self.y = y
        self.target = target
        self.damage = damage
        self.kind = kind
        self.speed = 510 if kind == "archer" else 370
        self.alive = True


