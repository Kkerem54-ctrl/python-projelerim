    def _button(self, label, command, color):
        button = tk.Button(
            self.panel, text=label, command=command, bg=color, fg="white",
            activebackground="#6b8376", activeforeground="white", relief="flat",
            font=("Segoe UI", 9, "bold"), pady=7, cursor="hand2",
        )
        button.pack(fill="x", pady=3)
        return button

    def _separator(self):
        tk.Frame(self.panel, bg="#354741", height=1).pack(fill="x", pady=10)

    def make_decorations(self):
        random.seed(18)
        items = []
        for _ in range(34):
            x = random.randint(20, FIELD_W - 20)
            y = random.randint(20, FIELD_H - 20)
            near_road = any(
                distance_to_segment(x, y, *PATH_POINTS[i], *PATH_POINTS[i + 1]) < 52
                for i in range(len(PATH_POINTS) - 1)
            )
            if not near_road:
                items.append((x, y, random.choice(["tree", "rock", "bush"])))
        random.seed()
        return items

    def load_high_score(self):
        try:
            with open(DATA_FILE, "r", encoding="utf-8") as file:
                return int(json.load(file).get("high_score", 0))
        except (OSError, ValueError, TypeError, AttributeError, json.JSONDecodeError):
            return 0

    def store_high_score(self):
        try:
            with open(DATA_FILE, "w", encoding="utf-8") as file:
                json.dump({"high_score": self.high_score}, file, ensure_ascii=False, indent=2)
        except OSError:
            self.status_var.set("Rekor dosyası yazılamadı; oyun devam ediyor.")

    def reset_game(self):
        self.money = 190
        self.base_health = 20
        self.wave = 0
        self.score = 0
        self.towers = []
        self.enemies = []
        self.projectiles = []
        self.spawn_queue = []
        self.spawn_timer = 0.0
        self.wave_active = False
        self.paused = False
        self.game_over = False
        self.build_kind = None
        self.selected_tower = None
        self.mouse_x, self.mouse_y = -100, -100
        self.message = "Bir kule seç, sonra haritaya tıklayarak yerleştir."
        self.path_lengths = [
            math.hypot(PATH_POINTS[i + 1][0] - PATH_POINTS[i][0],
                       PATH_POINTS[i + 1][1] - PATH_POINTS[i][1])
            for i in range(len(PATH_POINTS) - 1)
        ]
        self.total_path_length = sum(self.path_lengths)
        self.refresh_panel()

    def restart(self):
        self.reset_game()
        self.message = "Yeni oyun başladı. Savunmanı kur!"
        self.refresh_panel()

    def choose_tower(self, kind):
        if self.paused or self.game_over:
            return
        cost = TOWER_TYPES[kind]["cost"]
        if self.money < cost:
            self.message = f"{TOWER_TYPES[kind]['name']} için {cost}₺ gerekiyor."
            self.build_kind = None
        else:
            self.build_kind = kind
            self.selected_tower = None
            self.message = f"{TOWER_TYPES[kind]['name']} için uygun bir noktaya tıkla."
        self.refresh_panel()

    def on_canvas_motion(self, event):
        self.mouse_x, self.mouse_y = event.x, event.y

    def on_canvas_click(self, event):
        if self.paused or self.game_over:
            return
        x, y = event.x, event.y
        if self.build_kind:
            self.place_tower(self.build_kind, x, y)
            return
        nearest = None
        nearest_distance = 28
        for tower in self.towers:
            distance = math.hypot(tower.x - x, tower.y - y)
            if distance < nearest_distance:
                nearest = tower
                nearest_distance = distance
        self.selected_tower = nearest
        self.message = "Kule seçildi." if nearest else "Bir kule seç veya yeni kule yerleştir."
        self.refresh_panel()

    def valid_tower_position(self, x, y):
        margin = 27
        if not (margin <= x <= FIELD_W - margin and margin <= y <= FIELD_H - margin):
            return False
        if any(distance_to_segment(x, y, *PATH_POINTS[i], *PATH_POINTS[i + 1]) < 39
               for i in range(len(PATH_POINTS) - 1)):
            return False
        if any(math.hypot(x - tower.x, y - tower.y) < 48 for tower in self.towers):
            return False
        return True

    def place_tower(self, kind, x, y):
        if not self.valid_tower_position(x, y):
            self.message = "Buraya kule kurulamaz; yoldan ve diğer kulelerden uzaklaş."
            return
        cost = TOWER_TYPES[kind]["cost"]
        if self.money < cost:
            self.message = "Yeterli paran yok."
            self.build_kind = None
            return
        self.money -= cost
        tower = Tower(kind, x, y)
        self.towers.append(tower)
        self.selected_tower = tower
        self.build_kind = None
        self.message = f"{tower.info['name']} kuruldu."
        self.refresh_panel()

    def start_wave(self):
        if self.paused or self.game_over or self.wave_active:
            return
        self.wave += 1
        count = 5 + self.wave * 2
        available = ["scout"]
        if self.wave >= 2:
            available.append("runner")
        if self.wave >= 3:
            available.append("brute")
        if self.wave >= 4:
            available.append("armored")
        self.spawn_queue = [random.choice(available) for _ in range(count)]
        if self.wave % 5 == 0:
            self.spawn_queue.append("boss")
        self.spawn_timer = 0.0
        self.wave_active = True
        self.message = f"{self.wave}. dalga başladı! Düşman sayısı: {len(self.spawn_queue)}."
        self.refresh_panel()

    def toggle_pause(self):
        if self.game_over:
            return
        self.paused = not self.paused
        self.message = "Oyun duraklatıldı." if self.paused else "Oyun devam ediyor."
        self.last_tick = time.time()
        self.refresh_panel()

    def upgrade_selected(self):
        tower = self.selected_tower
        if not tower or tower.level >= 4 or self.paused or self.game_over:
            return
        cost = tower.upgrade_cost()
        if self.money < cost:
            self.message = f"Yükseltme için {cost}₺ gerekiyor."
            return
        self.money -= cost
        tower.level += 1
        self.message = f"{tower.info['name']} {tower.level}. seviyeye yükseltildi."
        self.refresh_panel()

    def sell_selected(self):
        tower = self.selected_tower
        if not tower:
            return
        value = tower.sell_value()
        self.money += value
        self.towers.remove(tower)
        self.selected_tower = None
        self.message = f"Kule satıldı; {value}₺ kazandın."
        self.refresh_panel()

    def save_game(self):
        if self.wave_active:
            self.message = "Kayıt yalnızca dalgalar arasında alınabilir."
            self.refresh_panel()
            return
        data = {
            "money": self.money,
            "base_health": self.base_health,
            "wave": self.wave,
            "score": self.score,
            "towers": [
                {"kind": tower.kind, "x": tower.x, "y": tower.y, "level": tower.level}
                for tower in self.towers
            ],
        }
        try:
            with open("tower_defense_save.json", "w", encoding="utf-8") as file:
                json.dump(data, file, ensure_ascii=False, indent=2)
            self.message = "Oyun kaydedildi. Yükleme, dalgalar arasındaki durumu geri getirir."
        except OSError:
            self.message = "Kayıt dosyası yazılamadı."
        self.refresh_panel()

    def load_game(self):
        try:
            with open("tower_defense_save.json", "r", encoding="utf-8") as file:
                data = json.load(file)
            towers = []
            for saved in data.get("towers", []):
                if saved.get("kind") not in TOWER_TYPES:
                    continue
                tower = Tower(saved["kind"], float(saved["x"]), float(saved["y"]))
                tower.level = max(1, min(4, int(saved.get("level", 1))))
                if self._position_valid_against(tower.x, tower.y, towers):
                    towers.append(tower)
            self.money = max(0, int(data.get("money", 190)))
            self.base_health = max(1, min(20, int(data.get("base_health", 20))))
            self.wave = max(0, int(data.get("wave", 0)))
            self.score = max(0, int(data.get("score", 0)))
            self.towers = towers
            self.enemies = []
            self.projectiles = []
            self.spawn_queue = []
            self.wave_active = False
            self.game_over = False
            self.paused = False
            self.selected_tower = None
            self.build_kind = None
            self.message = "Kayıt yüklendi. Sonraki dalgayı başlatabilirsin."
        except (OSError, ValueError, TypeError, AttributeError, json.JSONDecodeError):
            self.message = "Yüklenecek kayıt bulunamadı veya kayıt dosyası bozuk."
        self.refresh_panel()

    def _position_valid_against(self, x, y, towers):
        margin = 27
        if not (margin <= x <= FIELD_W - margin and margin <= y <= FIELD_H - margin):
            return False
        if any(distance_to_segment(x, y, *PATH_POINTS[i], *PATH_POINTS[i + 1]) < 39
               for i in range(len(PATH_POINTS) - 1)):
            return False
        return not any(math.hypot(x - tower.x, y - tower.y) < 48 for tower in towers)

    def update_game(self, dt, now):
        if self.wave_active:
            self.spawn_timer -= dt
            if self.spawn_queue and self.spawn_timer <= 0:
                kind = self.spawn_queue.pop(0)
                self.enemies.append(Enemy(kind, self.wave, self.path_lengths, self.total_path_length))
                self.spawn_timer = max(0.36, 0.82 - self.wave * 0.015)

        for enemy in self.enemies:
            reached_base = enemy.update(dt, now)
            if reached_base and enemy.alive:
                enemy.alive = False
                self.base_health -= enemy.base_damage
                self.message = f"{enemy.name} üsse ulaştı! Üs -{enemy.base_damage} can."
                if self.base_health <= 0:
                    self.base_health = 0
                    self.finish_game()

        for tower in self.towers:
            tower.cooldown -= dt
            if tower.cooldown > 0:
                continue
            candidates = [
                enemy for enemy in self.enemies
                if enemy.alive and math.hypot(enemy.x - tower.x, enemy.y - tower.y) <= tower.attack_range
            ]
            if not candidates:
                continue
            target = max(candidates, key=lambda enemy: enemy.travelled)
            tower.cooldown = tower.attack_rate
            if tower.kind == "frost":
                self.damage_enemy(target, tower.damage)
                if target.alive:
                    target.slow_until = now + 1.7
                    target.slow_factor = 0.55
            else:
                self.projectiles.append(Projectile(tower.x, tower.y, target, tower.damage, tower.kind))

        for projectile in self.projectiles:
            self.update_projectile(projectile, dt)

        self.enemies = [enemy for enemy in self.enemies if enemy.alive]
        self.projectiles = [projectile for projectile in self.projectiles if projectile.alive]
        if self.wave_active and not self.game_over and not self.spawn_queue and not self.enemies:
            self.wave_active = False
            bonus = 22 + self.wave * 5
            self.money += bonus
            self.score += bonus
            if self.score > self.high_score:
                self.high_score = self.score
                self.store_high_score()
            self.message = f"Dalga temizlendi! {bonus}₺ dalga ödülü kazandın."
            self.refresh_panel()

    def update_projectile(self, projectile, dt):
        target = projectile.target
        if not target.alive:
            projectile.alive = False
            return
        dx = target.x - projectile.x
        dy = target.y - projectile.y
        distance = math.hypot(dx, dy)
        step = projectile.speed * dt
        if distance <= step or distance == 0:
            projectile.x, projectile.y = target.x, target.y
            projectile.alive = False
            if projectile.kind == "cannon":
                for enemy in self.enemies:
                    if enemy.alive and math.hypot(enemy.x - target.x, enemy.y - target.y) <= 54:
                        self.damage_enemy(enemy, projectile.damage if enemy is target else projectile.damage * 0.58)
            else:
                self.damage_enemy(target, projectile.damage)
            return
        projectile.x += dx / distance * step
        projectile.y += dy / distance * step

    def damage_enemy(self, enemy, damage):
        if not enemy.alive:
            return
        enemy.health -= max(1, damage - enemy.armor)
        if enemy.health <= 0:
            enemy.alive = False
            self.money += enemy.reward
            self.score += enemy.reward
            if self.score > self.high_score:
                self.high_score = self.score
                self.store_high_score()

    def finish_game(self):
        if self.game_over:
            return
        self.game_over = True
        self.paused = False
        self.build_kind = None
        self.message = f"Üs düştü! Skorun: {self.score}. Yeniden başlatarak tekrar dene."
        if self.score > self.high_score:
            self.high_score = self.score
            self.store_high_score()
        self.refresh_panel()

    def refresh_panel(self):
        self.money_var.set(f"PARA     {self.money}₺")
        self.health_var.set(f"ÜS CANI     {self.base_health} / 20")
        self.wave_var.set(f"DALGA     {self.wave}")
        self.score_var.set(f"SKOR     {self.score}")
        self.record_var.set(f"EN İYİ SKOR     {self.high_score}")
        self.status_var.set(self.message)
        if self.wave_active:
            self.wave_button.configure(text=f"Dalga sürüyor ({len(self.spawn_queue)} bekliyor)", state="disabled")
        elif self.game_over:
            self.wave_button.configure(text="Üs Düştü", state="disabled")
        elif self.paused:
            self.wave_button.configure(text="Dalga Başlat", state="disabled")
        else:
            self.wave_button.configure(text="Sonraki Dalgayı Başlat", state="normal")
        self.pause_button.configure(text="Devam Et" if self.paused else "Oyunu Duraklat")
        self.save_button.configure(state="disabled" if self.wave_active or self.game_over else "normal")
        for kind, button in self.tower_buttons.items():
            button.configure(state="normal" if self.money >= TOWER_TYPES[kind]["cost"] and not self.paused and not self.game_over else "disabled")
        tower = self.selected_tower
        if tower and tower in self.towers:
            self.selected_var.set(
                f"{tower.info['name']} • Seviye {tower.level}\n"
                f"Hasar: {tower.damage:.0f}   Menzil: {tower.attack_range:.0f}\n"
                f"Saldırı aralığı: {tower.attack_rate:.2f} sn"
            )
            self.upgrade_button.configure(
                text=(f"Yükselt • {tower.upgrade_cost()}₺" if tower.level < 4 else "Maksimum Seviye"),
                state="normal" if tower.level < 4 and self.money >= tower.upgrade_cost() and not self.paused and not self.game_over else "disabled",
            )
            self.sell_button.configure(state="normal" if not self.game_over else "disabled")
        else:
            self.selected_var.set("Haritaya kule yerleştir veya mevcut kuleye tıkla.")
            self.upgrade_button.configure(text="Kuleyi Yükselt", state="disabled")
            self.sell_button.configure(text="Kuleyi Sat", state="disabled")

    def tick(self):
        now = time.time()
        dt = min(0.06, max(0.0, now - self.last_tick))
        self.last_tick = now
        if not self.paused and not self.game_over:
            self.update_game(dt, now)
        self.refresh_panel()
        self.draw()
        self.root.after(30, self.tick)

    def draw(self):
        self.canvas.delete("all")
        self.canvas.create_rectangle(0, 0, FIELD_W, FIELD_H, fill="#78996e", outline="")
        for x in range(0, FIELD_W, 40):
            for y in range(0, FIELD_H, 40):
                self.canvas.create_rectangle(x, y, x + 1, y + 1, fill="#88a77a", outline="")
        for x, y, kind in self.decorations:
            if kind == "tree":
                self.canvas.create_oval(x - 9, y - 5, x + 9, y + 13, fill="#416e4d", outline="")
                self.canvas.create_oval(x - 7, y - 13, x + 7, y + 3, fill="#4f8056", outline="")
            elif kind == "rock":
                self.canvas.create_oval(x - 6, y - 4, x + 7, y + 5, fill="#87927b", outline="#6d7968")
            else:
                self.canvas.create_oval(x - 7, y - 5, x + 7, y + 5, fill="#5c8a58", outline="")

        points = [coordinate for point in PATH_POINTS for coordinate in point]
        self.canvas.create_line(*points, fill="#695641", width=43, capstyle=tk.ROUND, joinstyle=tk.ROUND)
        self.canvas.create_line(*points, fill="#cbb58a", width=34, capstyle=tk.ROUND, joinstyle=tk.ROUND)
        self.canvas.create_line(*points, fill="#d9c69f", width=2, dash=(4, 10))

        sx, sy = PATH_POINTS[0]
        self.canvas.create_oval(sx + 6, sy - 19, sx + 43, sy + 19, fill="#385849", outline="#d6e1c7", width=2)
        self.canvas.create_text(sx + 24, sy, text="GİRİŞ", fill="white", font=("Segoe UI", 8, "bold"))
        bx, by = PATH_POINTS[-1]
        self.canvas.create_rectangle(bx - 50, by - 33, bx - 9, by + 33, fill="#7c3339", outline="#f1d7ac", width=2)
        self.canvas.create_text(bx - 29, by, text="ÜS", fill="white", font=("Segoe UI", 10, "bold"))

        for tower in self.towers:
            self.draw_tower(tower)
        for projectile in self.projectiles:
            color = "#ffd166" if projectile.kind == "archer" else "#f28c5b"
            radius = 4 if projectile.kind == "archer" else 6
            self.canvas.create_oval(projectile.x - radius, projectile.y - radius,
                                    projectile.x + radius, projectile.y + radius,
                                    fill=color, outline="#fff1c9")
        for enemy in self.enemies:
            self.draw_enemy(enemy)

        if self.build_kind:
            kind = self.build_kind
            info = TOWER_TYPES[kind]
            valid = self.valid_tower_position(self.mouse_x, self.mouse_y)
            color = "#baf0c2" if valid else "#f08b82"
            self.canvas.create_oval(
                self.mouse_x - info["range"], self.mouse_y - info["range"],
                self.mouse_x + info["range"], self.mouse_y + info["range"],
                outline=color, dash=(3, 4), width=2,
            )
            self.canvas.create_oval(self.mouse_x - 15, self.mouse_y - 15,
                                    self.mouse_x + 15, self.mouse_y + 15,
                                    fill=info["color"], stipple="gray50", outline=color, width=2)

        self.canvas.create_rectangle(12, 12, 208, 42, fill="#243a32", outline="#bac9ac")
        state = "DURAKLATILDI" if self.paused else ("OYUN BİTTİ" if self.game_over else "SAVUNMA HATTI")
        self.canvas.create_text(22, 27, text=state, anchor="w", fill="#f3f1df", font=("Segoe UI", 10, "bold"))
        if self.paused or self.game_over:
            overlay = "DURAKLATILDI" if self.paused else "ÜS DÜŞTÜ"
            self.canvas.create_rectangle(210, 260, 610, 340, fill="#17211f", stipple="gray50", outline="#f1d58a", width=2)
            self.canvas.create_text(410, 300, text=overlay, fill="white", font=("Segoe UI", 24, "bold"))

    def draw_tower(self, tower):
        info = tower.info
        if tower is self.selected_tower:
            self.canvas.create_oval(
                tower.x - tower.attack_range, tower.y - tower.attack_range,
                tower.x + tower.attack_range, tower.y + tower.attack_range,
                outline="#fff2b2", dash=(5, 4), width=2,
            )
        self.canvas.create_oval(tower.x - 19, tower.y - 15, tower.x + 19, tower.y + 21,
                                fill="#344a40", outline="#263b34", width=2)
        self.canvas.create_oval(tower.x - 16, tower.y - 19, tower.x + 16, tower.y + 13,
                                fill=info["color"], outline="#eff0d5", width=2)
        self.canvas.create_text(tower.x, tower.y - 3, text=info["short"], fill="white",
                                font=("Segoe UI", 12, "bold"))
        if tower.level > 1:
            self.canvas.create_oval(tower.x + 9, tower.y + 7, tower.x + 23, tower.y + 21,
                                    fill="#e6bd56", outline="#fff0b2")
            self.canvas.create_text(tower.x + 16, tower.y + 14, text=str(tower.level),
                                    fill="#3b3524", font=("Segoe UI", 8, "bold"))

    def draw_enemy(self, enemy):
        radius = 15 if enemy.kind == "boss" else (12 if enemy.kind in ("brute", "armored") else 10)
        self.canvas.create_oval(enemy.x - radius + 2, enemy.y - radius + 4,
                                enemy.x + radius + 2, enemy.y + radius + 4,
                                fill="#455443", outline="")
        self.canvas.create_oval(enemy.x - radius, enemy.y - radius,
                                enemy.x + radius, enemy.y + radius,
                                fill=enemy.color, outline="#fff0d6", width=1)
        if enemy.kind == "boss":
            self.canvas.create_text(enemy.x, enemy.y, text="!", fill="white", font=("Segoe UI", 13, "bold"))
        ratio = max(0.0, enemy.health / enemy.max_health)
        bar_width = radius * 2 + 6
        left = enemy.x - bar_width / 2
        top = enemy.y - radius - 9
        self.canvas.create_rectangle(left, top, left + bar_width, top + 5, fill="#542c31", outline="")
        bar_color = "#77d17c" if ratio > 0.55 else ("#e6c85d" if ratio > 0.25 else "#ed7167")
        self.canvas.create_rectangle(left, top, left + bar_width * ratio, top + 5, fill=bar_color, outline="")


def main():
    root = tk.Tk()
    TowerDefenseGame(root)
    root.mainloop()


if __name__ == "__main__":
    main()
