        self.root.resizable(False, False)
        self.root.configure(bg="#16211f")

        self.canvas = tk.Canvas(
            root, width=FIELD_W, height=FIELD_H,
            bg="#73966c", highlightthickness=0,
        )
        self.canvas.grid(row=0, column=0, rowspan=2, padx=(12, 8), pady=12)
        self.panel_view = tk.Frame(root, width=270, height=FIELD_H, bg="#1d2c2a")
        self.panel_view.grid(row=0, column=1, sticky="nsew", padx=(0, 12), pady=12)
        self.panel_view.grid_propagate(False)
        self.sidebar_canvas = tk.Canvas(
            self.panel_view, width=250, height=FIELD_H, bg="#1d2c2a", highlightthickness=0,
        )
        self.sidebar_scrollbar = tk.Scrollbar(
            self.panel_view, orient="vertical", command=self.sidebar_canvas.yview,
        )
        self.sidebar_canvas.configure(yscrollcommand=self.sidebar_scrollbar.set)
        self.sidebar_canvas.pack(side="left", fill="both", expand=True)
        self.sidebar_scrollbar.pack(side="right", fill="y")
        self.panel = tk.Frame(self.sidebar_canvas, bg="#1d2c2a", padx=14, pady=12)
        self.sidebar_canvas.create_window((0, 0), window=self.panel, anchor="nw", width=250)
        self.panel.bind(
            "<Configure>",
            lambda _event: self.sidebar_canvas.configure(scrollregion=self.sidebar_canvas.bbox("all")),
        )

        self._build_panel()
        self.canvas.bind("<Button-1>", self.on_canvas_click)
        self.canvas.bind("<Motion>", self.on_canvas_motion)

        self.high_score = self.load_high_score()
        self.decorations = self.make_decorations()
        self.reset_game()
        self.last_tick = time.time()
        self.root.after(30, self.tick)

