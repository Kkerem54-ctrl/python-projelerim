            font=("Segoe UI", 18, "bold"),
        ).pack(anchor="w")
        tk.Label(
            self.panel, text="Üssünü koru, dalgaları durdur.", bg="#1d2c2a",
            fg="#afc0b4", font=("Segoe UI", 9),
        ).pack(anchor="w", pady=(1, 13))

        self.money_var = tk.StringVar()
        self.health_var = tk.StringVar()
        self.wave_var = tk.StringVar()
        self.score_var = tk.StringVar()
        self.record_var = tk.StringVar()
        self.status_var = tk.StringVar()
