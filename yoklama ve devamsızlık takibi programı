    def refresh_assignments(self):
        if not hasattr(self, "assignment_tree") or not self.assignment_tree.winfo_exists():
            return
        for item in self.assignment_tree.get_children():
            self.assignment_tree.delete(item)
        class_id = self.assignment_filter_map.get(self.assignment_filter.get(), 0)
        rows = self.query("""SELECT a.id, a.title, a.due_date, c.name AS class_name,
            COUNT(t.student_id) AS assigned,
            SUM(CASE WHEN s.status IN ('Teslim edildi','Geç teslim edildi') THEN 1 ELSE 0 END) AS done,
            SUM(CASE WHEN s.status IN ('Bekleniyor','Eksik') THEN 1 ELSE 0 END) AS remaining
            FROM assignments a JOIN classes c ON c.id=a.class_id
            LEFT JOIN assignment_targets t ON t.assignment_id=a.id
            LEFT JOIN assignment_submissions s ON s.assignment_id=t.assignment_id AND s.student_id=t.student_id
            WHERE (?=0 OR a.class_id=?) AND (?=0 OR a.due_date < ?)
            GROUP BY a.id HAVING (?=0 OR SUM(CASE WHEN s.status IN ('Bekleniyor','Eksik') THEN 1 ELSE 0 END) > 0)
            ORDER BY a.due_date DESC, a.id DESC""",
            (class_id, class_id, int(self.overdue_only.get()), TODAY, int(self.overdue_only.get())))
        for row in rows:
            self.assignment_tree.insert("", "end", iid=str(row["id"]), values=(row["title"], row["class_name"],
                row["due_date"], row["assigned"], row["done"] or 0, row["remaining"] or 0))

