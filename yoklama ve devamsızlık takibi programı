    def valid_date(self, value: str) -> str:
        return date.fromisoformat(value.strip()).isoformat()

    def load_attendance(self):
        if not hasattr(self, "att_tree") or not self.att_tree.winfo_exists():
            return
        for item in self.att_tree.get_children():
            self.att_tree.delete(item)
        class_id = self.att_class_map.get(self.att_class.get())
        if not class_id:
            return
        try:
            attendance_date = self.valid_date(self.att_date.get())
        except ValueError:
            messagebox.showerror("Tarih biçimi hatalı", "Tarihi YYYY-MM-DD biçiminde girin.")
            return
        rows = self.query("""SELECT s.id, s.student_no, s.first_name, s.last_name, a.status
            FROM students s LEFT JOIN attendance_sessions se ON se.class_id=? AND se.attendance_date=?
            LEFT JOIN attendance a ON a.session_id=se.id AND a.student_id=s.id
            WHERE s.class_id=? AND s.active=1 ORDER BY s.last_name, s.first_name""",
            (class_id, attendance_date, class_id))
        for row in rows:
            self.att_tree.insert("", "end", iid=str(row["id"]), values=(row["student_no"],
                f'{row["first_name"]} {row["last_name"]}', row["status"] or "Bekliyor"))

    def set_attendance_status(self):
        selection = self.att_tree.selection()
        if not selection:
            messagebox.showinfo("Öğrenci seçin", "Durum uygulamak için bir öğrenci seçin.")
            return
        for item in selection:
            values = list(self.att_tree.item(item, "values"))
            values[2] = self.att_status.get()
            self.att_tree.item(item, values=values)

    def mark_all_present(self):
        for item in self.att_tree.get_children():
            values = list(self.att_tree.item(item, "values"))
            values[2] = "Geldi"
            self.att_tree.item(item, values=values)

    def save_attendance(self):
        class_id = self.att_class_map.get(self.att_class.get())
        if not class_id:
            messagebox.showinfo("Sınıf gerekli", "Önce sınıf oluşturun ve seçin.")
            return
        try:
            attendance_date = self.valid_date(self.att_date.get())
        except ValueError:
            messagebox.showerror("Tarih biçimi hatalı", "Tarihi YYYY-MM-DD biçiminde girin.")
            return
        try:
            with self.db.connect() as db:
                db.execute("INSERT OR IGNORE INTO attendance_sessions(class_id, attendance_date) VALUES (?, ?)",
                           (class_id, attendance_date))
                session_id = db.execute("SELECT id FROM attendance_sessions WHERE class_id=? AND attendance_date=?",
                                        (class_id, attendance_date)).fetchone()[0]
                for item in self.att_tree.get_children():
                    student_id = int(item)
                    status = self.att_tree.item(item, "values")[2]
                    if status == "Bekliyor":
                        db.execute("DELETE FROM attendance WHERE session_id=? AND student_id=?", (session_id, student_id))
                        continue
                    db.execute("""INSERT INTO attendance(session_id, student_id, status) VALUES (?, ?, ?)
                        ON CONFLICT(session_id, student_id) DO UPDATE SET status=excluded.status""",
                        (session_id, student_id, status))
            self.load_attendance()
            messagebox.showinfo("Kaydedildi", "Yoklama kaydedildi. Bu sınıf ve tarih için ikinci kayıt açılmaz.")
        except sqlite3.Error:
            logging.exception("Yoklama kaydedilemedi")
            messagebox.showerror("Kayıt hatası", "Yoklama kaydedilemedi. Uygulama günlüğünü kontrol edin.")

