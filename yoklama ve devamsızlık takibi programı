APP_NAME = "Öğretmen Asistanı"
STATUSES = ("Geldi", "Gelmedi", "Geç geldi", "İzinli")
SUBMISSION_STATUSES = ("Bekleniyor", "Teslim edildi", "Geç teslim edildi", "Eksik")
TODAY = date.today().isoformat()


def application_directory() -> Path:
    """Choose a persistent, per-user application-data directory."""
    if os.name == "nt":
        base = Path(os.environ.get("LOCALAPPDATA", Path.home() / "AppData" / "Local"))
    else:
        base = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local" / "share"))
    folder = base / "OgretmenAsistani"
    folder.mkdir(parents=True, exist_ok=True)
    return folder


APP_DIR = application_directory()
DB_PATH = APP_DIR / "ogretmen_asistani.sqlite3"
SETTINGS_PATH = APP_DIR / "ayarlar.json"
LOG_PATH = APP_DIR / "uygulama.log"
logging.basicConfig(filename=LOG_PATH, level=logging.INFO,
                    format="%(asctime)s %(levelname)s %(message)s", encoding="utf-8")


class Database:
    def __init__(self, path: Path = DB_PATH):
        self.path = path
        self.initialize()

    def connect(self) -> sqlite3.Connection:
        connection = sqlite3.connect(self.path)
        connection.row_factory = sqlite3.Row
        connection.execute("PRAGMA foreign_keys = ON")
        return connection

    def initialize(self) -> None:
        with self.connect() as db:
            db.executescript("""
                CREATE TABLE IF NOT EXISTS classes (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    name TEXT NOT NULL UNIQUE,
                    course_name TEXT NOT NULL DEFAULT '',
                    teacher_name TEXT NOT NULL DEFAULT '',
                    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
                );
                CREATE TABLE IF NOT EXISTS students (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    class_id INTEGER NOT NULL REFERENCES classes(id),
                    student_no TEXT NOT NULL,
                    first_name TEXT NOT NULL,
                    last_name TEXT NOT NULL,
                    active INTEGER NOT NULL DEFAULT 1 CHECK(active IN (0, 1)),
                    UNIQUE(class_id, student_no)
                );
                CREATE TABLE IF NOT EXISTS attendance_sessions (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    class_id INTEGER NOT NULL REFERENCES classes(id),
                    attendance_date TEXT NOT NULL,
                    UNIQUE(class_id, attendance_date)
                );
                CREATE TABLE IF NOT EXISTS attendance (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    session_id INTEGER NOT NULL REFERENCES attendance_sessions(id) ON DELETE CASCADE,
                    student_id INTEGER NOT NULL REFERENCES students(id),
                    status TEXT NOT NULL CHECK(status IN ('Geldi','Gelmedi','Geç geldi','İzinli')),
                    UNIQUE(session_id, student_id)
                );
                CREATE TABLE IF NOT EXISTS assignments (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    class_id INTEGER NOT NULL REFERENCES classes(id),
                    title TEXT NOT NULL,
                    description TEXT NOT NULL DEFAULT '',
                    due_date TEXT NOT NULL,
                    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
                );
                CREATE TABLE IF NOT EXISTS assignment_targets (
                    assignment_id INTEGER NOT NULL REFERENCES assignments(id) ON DELETE CASCADE,
                    student_id INTEGER NOT NULL REFERENCES students(id),
                    PRIMARY KEY(assignment_id, student_id)
                );
                CREATE TABLE IF NOT EXISTS assignment_submissions (
                    assignment_id INTEGER NOT NULL,
                    student_id INTEGER NOT NULL,
                    status TEXT NOT NULL DEFAULT 'Bekleniyor'
                        CHECK(status IN ('Bekleniyor','Teslim edildi','Geç teslim edildi','Eksik')),
                    score REAL,
                    teacher_note TEXT NOT NULL DEFAULT '',
                    submitted_on TEXT,
                    PRIMARY KEY(assignment_id, student_id),
                    FOREIGN KEY(assignment_id, student_id)
                        REFERENCES assignment_targets(assignment_id, student_id) ON DELETE CASCADE
                );
                CREATE INDEX IF NOT EXISTS idx_students_name ON students(last_name, first_name);
                CREATE INDEX IF NOT EXISTS idx_attendance_date ON attendance_sessions(attendance_date);
                CREATE INDEX IF NOT EXISTS idx_assignments_due ON assignments(due_date);
            """)


def load_settings() -> dict:
    defaults = {"absence_threshold": 5}
    try:
        data = json.loads(SETTINGS_PATH.read_text(encoding="utf-8"))
        if isinstance(data, dict):
            defaults.update(data)
    except (OSError, json.JSONDecodeError):
        pass
    return defaults


def save_settings(settings: dict) -> None:
    SETTINGS_PATH.write_text(json.dumps(settings, ensure_ascii=False, indent=2), encoding="utf-8")


class TeacherAssistant(tk.Tk):
    def __init__(self):
        super().__init__()
        self.db = Database()
        self.settings = load_settings()
        self.title(APP_NAME)
        self.geometry("1180x760")
        self.minsize(960, 620)
        self.configure(bg="#f4f6f9")
        self.style = ttk.Style(self)
        try:
            self.style.theme_use("clam")
        except tk.TclError:
            pass
        self._configure_style()
        self.sidebar = tk.Frame(self, bg="#17263c", width=220)
        self.sidebar.pack(side="left", fill="y")
        self.sidebar.pack_propagate(False)
        tk.Label(self.sidebar, text="ÖĞRETMEN\nASİSTANI", justify="left", anchor="w",
                 bg="#17263c", fg="white", font=("Segoe UI", 18, "bold"),
                 padx=22, pady=26).pack(fill="x")
        self.nav_buttons = {}
        for key, label in (("home", "Genel Bakış"), ("students", "Öğrenciler"),
                           ("attendance", "Yoklama"), ("assignments", "Ödevler"),
                           ("reports", "Raporlar")):
            button = tk.Button(self.sidebar, text=label, command=lambda k=key: self.show_page(k),
                               anchor="w", padx=24, pady=13, relief="flat", borderwidth=0,
                               bg="#17263c", fg="#d7e0eb", activebackground="#263b58",
                               activeforeground="white", font=("Segoe UI", 11))
            button.pack(fill="x", padx=10, pady=2)
            self.nav_buttons[key] = button
        tk.Label(self.sidebar, text="Çevrimdışı · Yerel SQLite", bg="#17263c", fg="#8fa2bb",
                 font=("Segoe UI", 9), anchor="w", padx=22).pack(side="bottom", fill="x", pady=18)
        self.main = tk.Frame(self, bg="#f4f6f9")
        self.main.pack(side="left", fill="both", expand=True)
        self.show_page("home")

    def _configure_style(self):
        self.style.configure("TFrame", background="#f4f6f9")
        self.style.configure("TLabel", background="#f4f6f9", foreground="#203047", font=("Segoe UI", 10))
        self.style.configure("Title.TLabel", font=("Segoe UI", 22, "bold"), foreground="#17263c")
        self.style.configure("Subtitle.TLabel", font=("Segoe UI", 10), foreground="#69798d")
        self.style.configure("TButton", font=("Segoe UI", 10), padding=(10, 7))
        self.style.configure("Primary.TButton", background="#2864d7", foreground="white")
        self.style.map("Primary.TButton", background=[("active", "#1e52b8")])
        self.style.configure("Treeview", rowheight=30, font=("Segoe UI", 10), background="white",
                             fieldbackground="white")
        self.style.configure("Treeview.Heading", font=("Segoe UI", 10, "bold"), padding=8)
        self.style.configure("TCombobox", padding=5)

    def clear_main(self):
        for child in self.main.winfo_children():
            child.destroy()

    def page_header(self, title: str, subtitle: str = ""):
        wrap = ttk.Frame(self.main, padding=(28, 24, 28, 10))
        wrap.pack(fill="x")
        ttk.Label(wrap, text=title, style="Title.TLabel").pack(anchor="w")
        if subtitle:
            ttk.Label(wrap, text=subtitle, style="Subtitle.TLabel").pack(anchor="w", pady=(5, 0))
        return wrap

    def body(self):
        body = ttk.Frame(self.main, padding=(28, 10, 28, 24))
        body.pack(fill="both", expand=True)
        return body

    def show_page(self, page: str):
        self.clear_main()
        for key, button in self.nav_buttons.items():
            button.configure(bg="#263b58" if key == page else "#17263c",
                             fg="white" if key == page else "#d7e0eb")
        pages = {"home": self.show_home, "students": self.show_students,
                 "attendance": self.show_attendance, "assignments": self.show_assignments,
                 "reports": self.show_reports}
        pages[page]()

    def query(self, sql: str, params=()):
        with self.db.connect() as db:
            return db.execute(sql, params).fetchall()

    def classes(self):
        return self.query("SELECT * FROM classes ORDER BY name")

    def class_options(self, include_all=False):
        options = [(int(row["id"]), row["name"]) for row in self.classes()]
        if include_all:
            options.insert(0, (0, "Tüm sınıflar"))
        return options

    def show_home(self):
        header = self.page_header("Genel Bakış", "Sınıflarınızın ve bugünkü işlerin kısa özeti")
        threshold = int(self.settings.get("absence_threshold", 5))
        ttk.Button(header, text=f"Devamsızlık eşiği: {threshold} gün", command=self.edit_threshold).pack(anchor="e", pady=(8, 0))
        body = self.body()
        with self.db.connect() as db:
            active_students = db.execute("SELECT COUNT(*) FROM students WHERE active=1").fetchone()[0]
            today_sessions = db.execute("SELECT COUNT(*) FROM attendance_sessions WHERE attendance_date=?", (TODAY,)).fetchone()[0]
            class_count = db.execute("SELECT COUNT(*) FROM classes").fetchone()[0]
            pending = db.execute("""SELECT COUNT(*) FROM assignment_submissions s
                JOIN assignments a ON a.id=s.assignment_id
                WHERE s.status IN ('Bekleniyor','Eksik') AND a.due_date < ?""", (TODAY,)).fetchone()[0]
            frequent = db.execute("""SELECT st.student_no, st.first_name, st.last_name, c.name,
                COUNT(*) AS absences FROM attendance at
                JOIN attendance_sessions se ON se.id=at.session_id
                JOIN students st ON st.id=at.student_id JOIN classes c ON c.id=st.class_id
                WHERE st.active=1 AND at.status='Gelmedi'
                GROUP BY st.id HAVING COUNT(*) >= ? ORDER BY absences DESC""", (threshold,)).fetchall()
            upcoming = db.execute("""SELECT a.title, a.due_date, c.name AS class_name,
                SUM(CASE WHEN s.status IN ('Bekleniyor','Eksik') THEN 1 ELSE 0 END) AS remaining
                FROM assignments a JOIN classes c ON c.id=a.class_id
                JOIN assignment_submissions s ON s.assignment_id=a.id
                WHERE a.due_date BETWEEN ? AND ?
                GROUP BY a.id ORDER BY a.due_date LIMIT 8""",
                (TODAY, (date.today() + timedelta(days=7)).isoformat())).fetchall()
        cards = ttk.Frame(body)
        cards.pack(fill="x")
        values = (("Aktif öğrenci", active_students), ("Sınıf", class_count),
                  ("Bugün yoklama alınan sınıf", f"{today_sessions}/{class_count}"),
                  ("Süresi geçmiş, tamamlanmamış", pending))
        for i, (label, value) in enumerate(values):
            card = tk.Frame(cards, bg="white", padx=18, pady=16, highlightbackground="#e3e8ef", highlightthickness=1)
            card.grid(row=0, column=i, sticky="nsew", padx=(0 if i == 0 else 10, 0), pady=4)
            cards.grid_columnconfigure(i, weight=1)
            tk.Label(card, text=str(value), bg="white", fg="#2864d7", font=("Segoe UI", 22, "bold")).pack(anchor="w")
            tk.Label(card, text=label, bg="white", fg="#69798d", font=("Segoe UI", 9)).pack(anchor="w", pady=(5, 0))
        columns = ttk.Frame(body)
        columns.pack(fill="both", expand=True, pady=(22, 0))
        left = ttk.LabelFrame(columns, text="Yaklaşan ödevler · 7 gün", padding=12)
        left.pack(side="left", fill="both", expand=True, padx=(0, 8))
        right = ttk.LabelFrame(columns, text=f"Devamsızlık eşiği · {threshold}+ gün", padding=12)
        right.pack(side="left", fill="both", expand=True, padx=(8, 0))
        upcoming_tree = self.make_tree(left, ("title", "class", "due", "remaining"),
                                       ("Ödev", "Sınıf", "Son tarih", "Bekleyen"), (220, 100, 100, 80))
        for row in upcoming:
            upcoming_tree.insert("", "end", values=(row["title"], row["class_name"], row["due_date"], row["remaining"]))
        frequent_tree = self.make_tree(right, ("no", "name", "class", "count"),
                                       ("No", "Öğrenci", "Sınıf", "Gün"), (60, 160, 90, 55))
        for row in frequent:
            frequent_tree.insert("", "end", values=(row["student_no"], f'{row["first_name"]} {row["last_name"]}', row["name"], row["absences"]))
        if not upcoming:
            ttk.Label(left, text="Önümüzdeki 7 günde teslim tarihi olan ödev yok.").pack(anchor="w", pady=10)
        if not frequent:
            ttk.Label(right, text="Eşiği aşan öğrenci yok.").pack(anchor="w", pady=10)

    def edit_threshold(self):
        dialog = tk.Toplevel(self)
        dialog.title("Devamsızlık eşiği")
        dialog.transient(self)
        dialog.grab_set()
        form = ttk.Frame(dialog, padding=18)
        form.pack(fill="both", expand=True)
        ttk.Label(form, text="Uyarı eşiği (Gelmedi sayısı)").pack(anchor="w")
        entry = ttk.Entry(form, width=10)
        entry.insert(0, str(self.settings.get("absence_threshold", 5)))
        entry.pack(anchor="w", pady=10)
        def save():
            try:
                value = int(entry.get())
                if value < 1:
                    raise ValueError
            except ValueError:
                messagebox.showerror("Değer hatalı", "Eşik 1 veya daha büyük bir tam sayı olmalıdır.", parent=dialog)
                return
            self.settings["absence_threshold"] = value
            try:
                save_settings(self.settings)
            except OSError as exc:
                messagebox.showerror("Ayar kaydedilemedi", str(exc), parent=dialog)
                return
            dialog.destroy()
            self.show_page("home")
        ttk.Button(form, text="Kaydet", style="Primary.TButton", command=save).pack(anchor="e")

    def make_tree(self, parent, columns, headings, widths, height=14):
        frame = ttk.Frame(parent)
        frame.pack(fill="both", expand=True)
        tree = ttk.Treeview(frame, columns=columns, show="headings", height=height)
        for col, heading, width in zip(columns, headings, widths):
            tree.heading(col, text=heading)
            tree.column(col, width=width, minwidth=45, anchor="w", stretch=True)
        ybar = ttk.Scrollbar(frame, orient="vertical", command=tree.yview)
        tree.configure(yscrollcommand=ybar.set)
        tree.pack(side="left", fill="both", expand=True)
        ybar.pack(side="right", fill="y")
        return tree

    def show_students(self):
        self.page_header("Öğrenciler", "Sınıfları ve öğrenci kayıtlarını yönetin")
        body = self.body()
        controls = ttk.Frame(body)
        controls.pack(fill="x", pady=(0, 12))
        ttk.Label(controls, text="Sınıf:").pack(side="left")
        options = self.class_options(include_all=True)
        self.student_class_map = {name: ident for ident, name in options}
        self.student_class = ttk.Combobox(controls, state="readonly", width=24, values=list(self.student_class_map))
        self.student_class.pack(side="left", padx=(7, 18))
        self.student_class.set(options[0][1] if options else "")
        ttk.Label(controls, text="Ara:").pack(side="left")
        self.student_search = ttk.Entry(controls, width=28)
        self.student_search.pack(side="left", padx=7)
        self.student_search.bind("<KeyRelease>", lambda _e: self.refresh_students())
        self.student_class.bind("<<ComboboxSelected>>", lambda _e: self.refresh_students())
        ttk.Button(controls, text="Sınıfları yönet", command=self.manage_classes).pack(side="right", padx=(8, 0))
        ttk.Button(controls, text="Öğrenci ekle", style="Primary.TButton", command=self.add_student).pack(side="right")
        area = ttk.Frame(body)
        area.pack(fill="both", expand=True)
        self.students_tree = self.make_tree(area, ("no", "first", "last", "class", "state"),
                                            ("Öğrenci no", "Ad", "Soyad", "Sınıf", "Durum"),
                                            (120, 180, 180, 160, 100), height=18)
        self.students_tree.bind("<Double-1>", lambda _e: self.edit_student())
        actions = ttk.Frame(body)
        actions.pack(fill="x", pady=(12, 0))
        ttk.Button(actions, text="Seçileni düzenle", command=self.edit_student).pack(side="left")
        ttk.Button(actions, text="Aktif / pasif değiştir", command=self.toggle_student).pack(side="left", padx=8)
        self.refresh_students()

    def refresh_students(self):
        if not hasattr(self, "students_tree") or not self.students_tree.winfo_exists():
            return
        for item in self.students_tree.get_children():
            self.students_tree.delete(item)
        class_id = self.student_class_map.get(self.student_class.get(), 0)
        search = self.student_search.get().strip()
        sql = """SELECT s.*, c.name AS class_name FROM students s JOIN classes c ON c.id=s.class_id
                 WHERE (?=0 OR s.class_id=?) AND (?='' OR s.student_no LIKE ? OR s.first_name LIKE ? OR s.last_name LIKE ?)
                 ORDER BY c.name, s.last_name, s.first_name"""
        rows = self.query(sql, (class_id, class_id, search, f"%{search}%", f"%{search}%", f"%{search}%"))
        for row in rows:
            self.students_tree.insert("", "end", iid=str(row["id"]), values=(row["student_no"], row["first_name"],
                row["last_name"], row["class_name"], "Aktif" if row["active"] else "Pasif"))

    def manage_classes(self):
        dialog = tk.Toplevel(self)
        dialog.title("Sınıfları yönet")
        dialog.transient(self)
        dialog.grab_set()
        dialog.geometry("520x420")
        ttk.Label(dialog, text="Sınıf listesi", font=("Segoe UI", 16, "bold")).pack(anchor="w", padx=18, pady=(18, 10))
        tree = self.make_tree(dialog, ("name", "course", "teacher"), ("Sınıf", "Ders", "Öğretmen"), (150, 150, 160), height=8)
        def refresh():
            for item in tree.get_children():
                tree.delete(item)
            for row in self.classes():
                tree.insert("", "end", iid=str(row["id"]), values=(row["name"], row["course_name"], row["teacher_name"]))
        def add_class():
            form = tk.Toplevel(dialog)
            form.title("Yeni sınıf")
            form.transient(dialog)
            form.grab_set()
            fields = {}
            for label in ("Sınıf adı", "Ders adı", "Öğretmen adı"):
                line = ttk.Frame(form, padding=(16, 7))
                line.pack(fill="x")
                ttk.Label(line, text=label, width=15).pack(side="left")
                entry = ttk.Entry(line, width=30)
                entry.pack(side="left", fill="x", expand=True)
                fields[label] = entry
            def save():
                name = fields["Sınıf adı"].get().strip()
                if not name:
                    messagebox.showerror("Eksik bilgi", "Sınıf adı zorunludur.", parent=form)
                    return
                try:
                    with self.db.connect() as db:
                        db.execute("INSERT INTO classes(name, course_name, teacher_name) VALUES (?, ?, ?)",
                                   (name, fields["Ders adı"].get().strip(), fields["Öğretmen adı"].get().strip()))
                    refresh()
                    if hasattr(self, "student_class") and self.student_class.winfo_exists():
                        options = self.class_options(include_all=True)
                        self.student_class_map = {name: ident for ident, name in options}
                        self.student_class.configure(values=list(self.student_class_map))
                        if options:
                            self.student_class.set(options[0][1])
                    if hasattr(self, "assignment_filter") and self.assignment_filter.winfo_exists():
                        options = self.class_options(include_all=True)
                        self.assignment_filter_map = {name: ident for ident, name in options}
                        self.assignment_filter.configure(values=list(self.assignment_filter_map))
                        if options:
                            self.assignment_filter.set(options[0][1])
                    self.refresh_students()
                    self.refresh_assignments()
                    form.destroy()
                except sqlite3.IntegrityError:
                    messagebox.showerror("Kayıt mevcut", "Bu sınıf adı zaten kullanılıyor.", parent=form)
            ttk.Button(form, text="Kaydet", style="Primary.TButton", command=save).pack(anchor="e", padx=16, pady=14)
            fields["Sınıf adı"].focus_set()
        ttk.Button(dialog, text="Sınıf ekle", style="Primary.TButton", command=add_class).pack(anchor="e", padx=18, pady=14)
        refresh()

    def student_dialog(self, student_id=None):
        options = self.class_options()
        if not options:
            messagebox.showinfo("Önce sınıf ekleyin", "Öğrenci eklemeden önce bir sınıf oluşturun.")
            self.manage_classes()
            return
        existing = self.query("SELECT * FROM students WHERE id=?", (student_id,))[0] if student_id else None
        dialog = tk.Toplevel(self)
        dialog.title("Öğrenciyi düzenle" if existing else "Öğrenci ekle")
        dialog.transient(self)
        dialog.grab_set()
        fields = {}
        rows = (("Sınıf", "class"), ("Öğrenci numarası", "no"), ("Ad", "first"), ("Soyad", "last"))
        for label, key in rows:
            line = ttk.Frame(dialog, padding=(18, 8))
            line.pack(fill="x")
            ttk.Label(line, text=label, width=18).pack(side="left")
            if key == "class":
                names = [name for _id, name in options]
                field = ttk.Combobox(line, state="readonly", values=names, width=27)
            else:
                field = ttk.Entry(line, width=30)
            field.pack(side="left", fill="x", expand=True)
            fields[key] = field
        class_map = {name: ident for ident, name in options}
        if existing:
            fields["class"].set(next(name for ident, name in options if ident == existing["class_id"]))
            for key, col in (("no", "student_no"), ("first", "first_name"), ("last", "last_name")):
                fields[key].insert(0, existing[col])
        elif names:
            fields["class"].set(names[0])
        def save():
            class_id = class_map.get(fields["class"].get())
            number, first, last = (fields[k].get().strip() for k in ("no", "first", "last"))
            if not class_id or not number or not first or not last:
                messagebox.showerror("Eksik bilgi", "Sınıf, öğrenci numarası, ad ve soyad zorunludur.", parent=dialog)
                return
            try:
                with self.db.connect() as db:
                    if existing:
                        db.execute("UPDATE students SET class_id=?, student_no=?, first_name=?, last_name=? WHERE id=?",
                                   (class_id, number, first, last, student_id))
                    else:
                        db.execute("INSERT INTO students(class_id, student_no, first_name, last_name) VALUES (?, ?, ?, ?)",
                                   (class_id, number, first, last))
                dialog.destroy()
                self.refresh_students()
            except sqlite3.IntegrityError:
                messagebox.showerror("Numara kullanılıyor", "Bu sınıfta aynı öğrenci numarası zaten kayıtlı.", parent=dialog)
        ttk.Button(dialog, text="Kaydet", style="Primary.TButton", command=save).pack(anchor="e", padx=18, pady=14)

    def add_student(self):
        self.student_dialog()

    def selected_student_id(self):
        selection = self.students_tree.selection()
        return int(selection[0]) if selection else None

    def edit_student(self):
        student_id = self.selected_student_id()
        if student_id is None:
            messagebox.showinfo("Öğrenci seçin", "Düzenlemek için listeden bir öğrenci seçin.")
            return
        self.student_dialog(student_id)

    def toggle_student(self):
        student_id = self.selected_student_id()
        if student_id is None:
            messagebox.showinfo("Öğrenci seçin", "Durumunu değiştirmek için listeden bir öğrenci seçin.")
            return
        with self.db.connect() as db:
            db.execute("UPDATE students SET active=1-active WHERE id=?", (student_id,))
        self.refresh_students()

    def show_attendance(self):
