        def fill_students(_event=None):
            student_list.delete(0, "end")
            class_id = class_map.get(class_combo.get())
            for row in self.query("SELECT id, student_no, first_name, last_name FROM students WHERE class_id=? AND active=1 ORDER BY last_name, first_name", (class_id,)):
                student_list.insert("end", f'{row["student_no"]} · {row["first_name"]} {row["last_name"]}')
            student_list.student_ids = [r["id"] for r in self.query(
                "SELECT id FROM students WHERE class_id=? AND active=1 ORDER BY last_name, first_name", (class_id,))]
        class_combo.bind("<<ComboboxSelected>>", fill_students)
        all_var.trace_add("write", lambda *_: student_list.configure(state="disabled" if all_var.get() else "normal"))
        form.columnconfigure(1, weight=1)
        form.rowconfigure(5, weight=1)
        fill_students()
        def save():
            title = title_entry.get().strip()
            try:
                due = self.valid_date(due_entry.get())
