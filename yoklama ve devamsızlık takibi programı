    def manage_submission(self):
        selection = self.assignment_tree.selection()
        if not selection:
            messagebox.showinfo("Ödev seçin", "Durumları yönetmek için listeden bir ödev seçin.")
            return
        assignment_id = int(selection[0])
        assignment = self.query("SELECT a.*, c.name AS class_name FROM assignments a JOIN classes c ON c.id=a.class_id WHERE a.id=?", (assignment_id,))[0]
        dialog = tk.Toplevel(self)
        dialog.title(f'Teslimler · {assignment["title"]}')
        dialog.transient(self)
        dialog.grab_set()
        dialog.geometry("800x590")
        ttk.Label(dialog, text=f'{assignment["title"]} · {assignment["class_name"]} · Son tarih: {assignment["due_date"]}',
                  font=("Segoe UI", 13, "bold")).pack(anchor="w", padx=18, pady=16)
        tree = self.make_tree(dialog, ("no", "name", "status", "score", "note"),
                              ("Öğrenci no", "Öğrenci", "Durum", "Puan", "Öğretmen notu"),
                              (100, 190, 145, 70, 230), height=10)
        rows = self.query("""SELECT st.id, st.student_no, st.first_name, st.last_name,
            t.assignment_id AS assigned, s.status, s.score, s.teacher_note FROM students st
            LEFT JOIN assignment_targets t ON t.student_id=st.id AND t.assignment_id=?
            LEFT JOIN assignment_submissions s ON s.assignment_id=t.assignment_id AND s.student_id=st.id
            WHERE st.class_id=? AND (st.active=1 OR t.assignment_id IS NOT NULL)
            ORDER BY st.last_name, st.first_name""", (assignment_id, assignment["class_id"]))
        for row in rows:
            status = row["status"] or "Verilmedi / atanmadı"
            tag = () if row["assigned"] is not None else ("unassigned",)
            tree.insert("", "end", iid=str(row["id"]), values=(row["student_no"], f'{row["first_name"]} {row["last_name"]}',
                status, "" if row["score"] is None else row["score"], row["teacher_note"]), tags=tag)
        tree.tag_configure("unassigned", foreground="#8996a7")
        editor = ttk.LabelFrame(dialog, text="Seçili öğrencinin kaydı", padding=12)
        editor.pack(fill="x", padx=18, pady=12)
        ttk.Label(editor, text="Durum").grid(row=0, column=0, sticky="w", padx=5)
        status_combo = ttk.Combobox(editor, state="readonly", values=SUBMISSION_STATUSES, width=20)
        status_combo.grid(row=1, column=0, padx=5, sticky="w")
        ttk.Label(editor, text="Puan (isteğe bağlı)").grid(row=0, column=1, sticky="w", padx=5)
        score_entry = ttk.Entry(editor, width=16)
        score_entry.grid(row=1, column=1, padx=5, sticky="w")
        ttk.Label(editor, text="Öğretmen notu").grid(row=0, column=2, sticky="w", padx=5)
        note_entry = ttk.Entry(editor, width=38)
        note_entry.grid(row=1, column=2, padx=5, sticky="ew")
        editor.columnconfigure(2, weight=1)
        save_button = None
        def populate(_event=None):
            sel = tree.selection()
            if not sel:
                return
            values = tree.item(sel[0], "values")
            assigned = "unassigned" not in tree.item(sel[0], "tags")
            status_combo.configure(state="readonly")
            score_entry.configure(state="normal")
            note_entry.configure(state="normal")
            status_combo.set(values[2] if assigned else "Verilmedi / atanmadı")
            score_entry.delete(0, "end")
            if assigned:
                score_entry.insert(0, values[3])
            note_entry.delete(0, "end")
            if assigned:
                note_entry.insert(0, values[4])
            if not assigned:
                status_combo.configure(state="disabled")
                score_entry.configure(state="disabled")
                note_entry.configure(state="disabled")
            if save_button:
                save_button.configure(state="normal" if assigned else "disabled")
        tree.bind("<<TreeviewSelect>>", populate)
        def save_submission():
            sel = tree.selection()
            if not sel:
                messagebox.showinfo("Öğrenci seçin", "Önce bir öğrenci seçin.", parent=dialog)
                return
            if "unassigned" in tree.item(sel[0], "tags"):
                return
            raw_score = score_entry.get().strip()
            try:
                score = None if not raw_score else float(raw_score.replace(",", "."))
                if score is not None and not 0 <= score <= 100:
                    raise ValueError
            except ValueError:
                messagebox.showerror("Puan hatalı", "Puanı 0-100 arasında girin.", parent=dialog)
                return
            student_id = int(sel[0])
            status = status_combo.get()
            submitted_on = date.today().isoformat() if status in ("Teslim edildi", "Geç teslim edildi") else None
            with self.db.connect() as db:
                db.execute("""UPDATE assignment_submissions SET status=?, score=?, teacher_note=?, submitted_on=?
                    WHERE assignment_id=? AND student_id=?""",
                    (status, score, note_entry.get().strip(), submitted_on, assignment_id, student_id))
            current = list(tree.item(str(student_id), "values"))
            current[2:] = [status, "" if score is None else score, note_entry.get().strip()]
            tree.item(str(student_id), values=current)
            self.refresh_assignments()
        save_button = ttk.Button(editor, text="Durumu kaydet", style="Primary.TButton", command=save_submission)
        save_button.grid(row=1, column=3, padx=5)
        if rows:
            tree.selection_set(str(rows[0]["id"]))
            populate()

