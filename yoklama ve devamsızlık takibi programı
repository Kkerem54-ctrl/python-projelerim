    def report_rows(self):
        start = self.valid_date(self.report_start.get())
        end = self.valid_date(self.report_end.get())
        if start > end:
            raise ValueError("Başlangıç tarihi bitiş tarihinden sonra olamaz.")
        class_id = self.report_class_map.get(self.report_class.get(), 0)
        kind = self.report_type.get()
        if kind == "Öğrenci yoklama özeti":
            headers = ["Sınıf", "Öğrenci no", "Öğrenci", "Geldi", "Gelmedi", "Geç geldi", "İzinli", "Devamsızlık oranı %"]
            rows = self.query("""SELECT c.name, st.student_no, st.first_name, st.last_name,
                SUM(CASE WHEN at.status='Geldi' THEN 1 ELSE 0 END) AS present,
                SUM(CASE WHEN at.status='Gelmedi' THEN 1 ELSE 0 END) AS absent,
                SUM(CASE WHEN at.status='Geç geldi' THEN 1 ELSE 0 END) AS late,
                SUM(CASE WHEN at.status='İzinli' THEN 1 ELSE 0 END) AS excused, COUNT(at.id) AS total
                FROM students st JOIN classes c ON c.id=st.class_id
                LEFT JOIN attendance_sessions se ON se.class_id=st.class_id AND se.attendance_date BETWEEN ? AND ?
                LEFT JOIN attendance at ON at.session_id=se.id AND at.student_id=st.id
                WHERE st.active=1 AND (?=0 OR st.class_id=?)
                GROUP BY st.id ORDER BY c.name, st.last_name, st.first_name""",
                (start, end, class_id, class_id))
            data = [(r["name"], r["student_no"], f'{r["first_name"]} {r["last_name"]}', r["present"] or 0,
                     r["absent"] or 0, r["late"] or 0, r["excused"] or 0,
                     round((r["absent"] or 0) * 100 / r["total"], 1) if r["total"] else 0) for r in rows]
            return headers, data
        if kind == "Günlük yoklama listesi":
            headers = ["Tarih", "Sınıf", "Öğrenci no", "Öğrenci", "Durum"]
            rows = self.query("""SELECT se.attendance_date, c.name, st.student_no, st.first_name, st.last_name,
                COALESCE(at.status, 'İşaretlenmedi') AS status
                FROM attendance_sessions se JOIN classes c ON c.id=se.class_id
                JOIN students st ON st.class_id=se.class_id AND st.active=1
                LEFT JOIN attendance at ON at.session_id=se.id AND at.student_id=st.id
                WHERE se.attendance_date BETWEEN ? AND ? AND (?=0 OR se.class_id=?)
                ORDER BY se.attendance_date, c.name, st.last_name, st.first_name""",
                (start, end, class_id, class_id))
            return headers, [(r["attendance_date"], r["name"], r["student_no"],
                              f'{r["first_name"]} {r["last_name"]}', r["status"]) for r in rows]
        if kind == "Öğrenci ödev özeti":
            headers = ["Sınıf", "Öğrenci no", "Öğrenci", "Atanan", "Teslim edilen", "Bekleyen / eksik", "Puan ortalaması"]
            rows = self.query("""SELECT c.name, st.student_no, st.first_name, st.last_name,
                COUNT(s.assignment_id) AS assigned,
                SUM(CASE WHEN s.status IN ('Teslim edildi','Geç teslim edildi') THEN 1 ELSE 0 END) AS delivered,
                SUM(CASE WHEN s.status IN ('Bekleniyor','Eksik') THEN 1 ELSE 0 END) AS remaining,
                AVG(s.score) AS average_score FROM students st JOIN classes c ON c.id=st.class_id
                LEFT JOIN assignments a ON a.class_id=st.class_id AND a.due_date BETWEEN ? AND ?
                LEFT JOIN assignment_submissions s ON s.assignment_id=a.id AND s.student_id=st.id
                WHERE st.active=1 AND (?=0 OR st.class_id=?)
                GROUP BY st.id ORDER BY c.name, st.last_name, st.first_name""",
                (start, end, class_id, class_id))
            return headers, [(r["name"], r["student_no"], f'{r["first_name"]} {r["last_name"]}',
                              r["assigned"] or 0, r["delivered"] or 0, r["remaining"] or 0,
                              "" if r["average_score"] is None else round(r["average_score"], 1)) for r in rows]
        headers = ["Sınıf", "Ödev", "Son tarih", "Öğrenci no", "Öğrenci", "Durum", "Puan", "Öğretmen notu"]
        rows = self.query("""SELECT c.name, a.title, a.due_date, st.student_no, st.first_name,
            st.last_name, s.status, s.score, s.teacher_note FROM assignment_submissions s
            JOIN assignments a ON a.id=s.assignment_id JOIN classes c ON c.id=a.class_id
            JOIN students st ON st.id=s.student_id WHERE a.due_date BETWEEN ? AND ?
            AND (?=0 OR a.class_id=?) ORDER BY a.due_date, c.name, st.last_name""",
            (start, end, class_id, class_id))
        return headers, [(r["name"], r["title"], r["due_date"], r["student_no"],
                          f'{r["first_name"]} {r["last_name"]}', r["status"], r["score"], r["teacher_note"]) for r in rows]

    def generate_report(self):
        try:
            headers, rows = self.report_rows()
        except (ValueError, sqlite3.Error) as exc:
            messagebox.showerror("Rapor oluşturulamadı", str(exc))
            return
        self.report_data = (headers, rows)
        for item in self.report_tree.get_children():
            self.report_tree.delete(item)
        for index, col in enumerate(self.report_tree["columns"]):
            if index < len(headers):
                self.report_tree.heading(col, text=headers[index])
                self.report_tree.column(col, width=145 if index < 3 else 120)
            else:
                self.report_tree.heading(col, text="")
                self.report_tree.column(col, width=0, stretch=False)
        for row in rows:
            self.report_tree.insert("", "end", values=row)

    def export_report(self):
        if not self.report_data[0]:
            self.generate_report()
        headers, rows = self.report_data
        if not headers:
            return
        path = filedialog.asksaveasfilename(title="CSV raporunu kaydet", defaultextension=".csv",
            filetypes=(("CSV dosyası", "*.csv"),), initialfile="ogretmen_raporu.csv")
        if not path:
            return
        try:
            with open(path, "w", newline="", encoding="utf-8-sig") as file:
                writer = csv.writer(file, delimiter=";")
                writer.writerow(headers)
                writer.writerows(rows)
            messagebox.showinfo("Dışa aktarıldı", f"Rapor kaydedildi:\n{path}")
        except OSError as exc:
            logging.exception("CSV dışa aktarılamadı")
            messagebox.showerror("Dosya kaydedilemedi", str(exc))


